// Benchmark 1: End Language with Region Scoping (Zero GC, Deterministic Memory)
st Request {
    id: u64,
    payload_size: i32,
    checksum: i64,
}

fn process_request(id: u64, size: i32) Request {
    val hash: u64 = (id * 15888297662290895648) + 3596094924569029098
    val req = Request {
        id: id,
        payload_size: size,
        checksum: hash as i64,
    }
    ret req
}

fn main() void {
    val iterations: u64 = 1000000
    mut total_checksum: i64 = 0

    println("Running End Backend Benchmark (1,000,000 requests)...")

    region bench_scope {
        for i in iterations {
            val req = process_request(i, 256)
            total_checksum = total_checksum + req.checksum
        }
    }

    println("End Benchmark Finished. Total Checksum:")
    println(total_checksum)
}
