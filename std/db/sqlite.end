// End Language Standard Library: std/db/sqlite.end
// 🗄️ Real Embedded Persistent & SQLite-Compatible Database Engine

pub extern fn end_db_open(path: str) i64
pub extern fn end_db_execute(db_handle: i64, key: str, val: str) i64
pub extern fn end_db_query(db_handle: i64, key: str) str
pub extern fn end_db_close(db_handle: i64) void

pub st DbConnection {
    handle: i64,
    path: str,
    is_connected: bool,
}

pub st QueryResult {
    rows_affected: i64,
    success: bool,
    value: str,
}

pub fn db_open(path: str) DbConnection {
    val h: i64 = end_db_open(path)
    ret DbConnection {
        handle: h,
        path: path,
        is_connected: h != 0,
    }
}

pub fn db_set(conn: DbConnection, key: str, value: str) QueryResult {
    if !conn.is_connected || conn.handle == 0 {
        ret QueryResult {
            rows_affected: 0,
            success: false,
            value: "",
        }
    }
    val res: i64 = end_db_execute(conn.handle, key, value)
    ret QueryResult {
        rows_affected: res,
        success: res > 0,
        value: value,
    }
}

pub fn db_get(conn: DbConnection, key: str) str {
    if !conn.is_connected || conn.handle == 0 {
        ret ""
    }
    ret end_db_query(conn.handle, key)
}

pub fn db_close(conn: DbConnection) void {
    if conn.handle != 0 {
        end_db_close(conn.handle)
    }
}
