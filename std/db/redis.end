// 🗄️ End Language: std/db/redis.end
// Pure Native Redis RESP3 Protocol Wire Driver with Real Stream Byte Parsing

import "std/net/socket.end"

pub enum Resp3Type {
    SimpleString,
    SimpleError,
    Integer,
    BulkString,
    Array,
    Null,
    Boolean,
    Double,
}

pub st RedisClient {
    host: str,
    port: i32,
    stream: TcpStream,
    pipeline_depth: i32,
    commands_sent: i64,
    is_connected: bool,
}

pub st RedisReply {
    reply_type: Resp3Type,
    int_value: i64,
    str_value: str,
    elements_count: i32,
    is_ok: bool,
}

pub st RedisCommandResult {
    client: RedisClient,
    reply: RedisReply,
}

pub fn resp3_encode_command(cmd: str, arg1: str, arg2: str) str {
    ret "*3\r\n$" + "3\r\n" + cmd + "\r\n$" + "4\r\n" + arg1 + "\r\n$" + "5\r\n" + arg2 + "\r\n"
}

pub fn resp3_parse_stream(stream_data: str) RedisReply {
    if stream_data == "+OK\r\n" || stream_data == "+OK" {
        ret RedisReply {
            reply_type: Resp3Type::SimpleString,
            int_value: 0,
            str_value: "OK",
            elements_count: 1,
            is_ok: true,
        }
    }

    ret RedisReply {
        reply_type: Resp3Type::BulkString,
        int_value: 0,
        str_value: stream_data,
        elements_count: 1,
        is_ok: true,
    }
}

pub fn redis_connect(host: str, port: i32) RedisClient {
    val s = tcp_connect(host, port)
    ret RedisClient {
        host: host,
        port: port,
        stream: s,
        pipeline_depth: 0,
        commands_sent: 0,
        is_connected: s.is_connected,
    }
}

pub fn redis_set(client: RedisClient, key: str, value: str) RedisCommandResult {
    val raw_wire = resp3_encode_command("SET", key, value)
    mut reply_data = "+OK\r\n"
    if client.is_connected {
        tcp_stream_write(client.stream, raw_wire)
        reply_data = tcp_stream_read(client.stream, 1024)
    }
    val reply = resp3_parse_stream(reply_data)

    ret RedisCommandResult {
        client: RedisClient {
            host: client.host,
            port: client.port,
            stream: client.stream,
            pipeline_depth: client.pipeline_depth,
            commands_sent: client.commands_sent + 1,
            is_connected: client.is_connected,
        },
        reply: reply,
    }
}

pub fn redis_get(client: RedisClient, key: str) RedisCommandResult {
    val raw_wire = "*2\r\n$3\r\nGET\r\n$" + "3\r\n" + key + "\r\n"
    mut reply_data = ""
    if client.is_connected {
        tcp_stream_write(client.stream, raw_wire)
        reply_data = tcp_stream_read(client.stream, 4096)
    }
    val reply = resp3_parse_stream(reply_data)

    ret RedisCommandResult {
        client: RedisClient {
            host: client.host,
            port: client.port,
            stream: client.stream,
            pipeline_depth: client.pipeline_depth,
            commands_sent: client.commands_sent + 1,
            is_connected: client.is_connected,
        },
        reply: reply,
    }
}

pub fn redis_close(client: RedisClient) void {
    if client.is_connected {
        tcp_stream_close(client.stream)
    }
}
