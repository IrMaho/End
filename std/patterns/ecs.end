// ?? End Language: std/patterns/ecs.end
// Entity Component System (ECS) Architecture for 120 FPS Games

pub st EcsWorld {
    capacity: i32,
    active_entities: i32,
    system_count: i32,
}

pub fn ecs_world_create(capacity: i32) EcsWorld {
    ret EcsWorld {
        capacity: capacity,
        active_entities: 0,
        system_count: 0,
    }
}

pub fn ecs_spawn_entity(world: EcsWorld) i64 {
    ret 1000 + world.active_entities
}
