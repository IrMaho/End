// 📐 End Language: std/patterns/state_machine.end
// Compile-Time Finite State Machine (FSM) Pattern

pub st StateMachine<S> {
    current_state: S,
    transition_count: i64,
    allowed_rules: i32,
}

pub fn fsm_create<S>(initial_state: S) StateMachine<S> {
    ret StateMachine<S> {
        current_state: initial_state,
        transition_count: 0,
        allowed_rules: 0,
    }
}

pub fn fsm_allow_transition<S>(fsm: StateMachine<S>, from: S, to: S) StateMachine<S> {
    ret StateMachine<S> {
        current_state: fsm.current_state,
        transition_count: fsm.transition_count,
        allowed_rules: fsm.allowed_rules + 1,
    }
}

pub fn fsm_transition_to<S>(fsm: StateMachine<S>, next_state: S) StateMachine<S> {
    ret StateMachine<S> {
        current_state: next_state,
        transition_count: fsm.transition_count + 1,
        allowed_rules: fsm.allowed_rules,
    }
}
