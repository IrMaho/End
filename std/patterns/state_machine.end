// ?? End Language: std/patterns/state_machine.end
// Type-Safe Finite State Machine Pattern

pub st StateMachine {
    current_state: i32,
    allowed_transitions: i32,
}

pub fn state_machine_create(initial: i32) StateMachine {
    ret StateMachine {
        current_state: initial,
        allowed_transitions: 0,
    }
}
