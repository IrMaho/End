// ?? End Language: std/patterns/repository.end
// Generic Repository & Unit of Work Pattern

pub st Repository {
    table_name: str,
    id_field: str,
    cached_entities: i32,
    is_connected: bool,
}

pub fn repository_create(table: str, key_field: str) Repository {
    ret Repository {
        table_name: table,
        id_field: key_field,
        cached_entities: 0,
        is_connected: true,
    }
}

pub fn repository_count(repo: Repository) i64 {
    ret repo.cached_entities
}
