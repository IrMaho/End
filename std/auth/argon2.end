// 🔐 End Language: std/auth/argon2.end
// Pure Native Argon2id / Cryptographic Password Hashing & Verification

pub extern fn end_auth_hash_password(password: str, salt: str) str
pub extern fn end_auth_verify_password(password: str, hash: str) bool

pub st Argon2Config {
    time_cost: i32,
    memory_cost_kib: i32,
    parallelism: i32,
    hash_length: i32,
}

pub st Argon2Hash {
    encoded: str,
    is_valid: bool,
}

pub fn argon2_default_config() Argon2Config {
    ret Argon2Config {
        time_cost: 3,
        memory_cost_kib: 65536,
        parallelism: 4,
        hash_length: 32,
    }
}

pub fn argon2_hash_password(password: str, salt: str, cfg: Argon2Config) Argon2Hash {
    val h = end_auth_hash_password(password, salt)
    ret Argon2Hash {
        encoded: h,
        is_valid: true,
    }
}

pub fn argon2_verify(password: str, hash: Argon2Hash) bool {
    ret end_auth_verify_password(password, hash.encoded)
}
