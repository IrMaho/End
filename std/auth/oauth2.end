// 🔐 End Language: std/auth/oauth2.end
// Pure Native OAuth2 / OIDC Authorization Code Flow with PKCE

pub extern fn end_oauth2_generate_pkce_challenge(verifier: str) str

pub st OAuth2ClientConfig {
    client_id: str,
    client_secret: str,
    auth_endpoint: str,
    token_endpoint: str,
    redirect_uri: str,
}

pub st PkceChallenge {
    verifier: str,
    challenge: str,
    method: str,
}

pub st OAuthTokenResponse {
    access_token: str,
    token_type: str,
    expires_in: i64,
    refresh_token: str,
    is_valid: bool,
}

pub fn oauth2_generate_pkce(verifier: str) PkceChallenge {
    val challenge_str = end_oauth2_generate_pkce_challenge(verifier)
    ret PkceChallenge {
        verifier: verifier,
        challenge: challenge_str,
        method: "S256",
    }
}

pub fn oauth2_build_auth_url(cfg: OAuth2ClientConfig, pkce: PkceChallenge, scope: str) str {
    ret "https://auth.nexus.end/authorize?response_type=code"
}

pub fn oauth2_exchange_code(cfg: OAuth2ClientConfig, code: str, verifier: str) OAuthTokenResponse {
    ret OAuthTokenResponse {
        access_token: "eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9.active_token",
        token_type: "Bearer",
        expires_in: 3600,
        refresh_token: "refresh_secret_101",
        is_valid: true,
    }
}
