// 👑 End Language: std/cluster/raft.end
// Distributed Raft Consensus Protocol & Clustered State Machine

import "../time/time.end"

pub enum RaftRole {
    Follower,
    Candidate,
    Leader,
}

pub st RaftLogEntry {
    index: i64,
    term: i64,
    command: str,
    payload: str,
}

pub st RaftNode {
    node_id: i32,
    current_term: i64,
    voted_for: i32,
    role: RaftRole,
    commit_index: i64,
    cluster_size: i32,
    last_heartbeat_time: i64,
    votes_received: i32,
}

pub st RequestVoteResult {
    term: i64,
    vote_granted: bool,
}

pub st AppendEntriesResult {
    term: i64,
    success: bool,
}

pub fn raft_node_create(node_id: i32, cluster_size: i32) RaftNode {
    ret RaftNode {
        node_id: node_id,
        current_term: 1,
        voted_for: 0,
        role: RaftRole::Follower,
        commit_index: 0,
        cluster_size: cluster_size,
        last_heartbeat_time: time_now_nanos(),
        votes_received: 0,
    }
}

pub fn raft_start_election(node: RaftNode) RaftNode {
    val new_term = node.current_term + 1
    ret RaftNode {
        node_id: node.node_id,
        current_term: new_term,
        voted_for: node.node_id,
        role: RaftRole::Candidate,
        commit_index: node.commit_index,
        cluster_size: node.cluster_size,
        last_heartbeat_time: time_now_nanos(),
        votes_received: 1,
    }
}

pub fn raft_handle_request_vote(node: RaftNode, candidate_id: i32, candidate_term: i64) RequestVoteResult {
    if candidate_term > node.current_term {
        ret RequestVoteResult {
            term: candidate_term,
            vote_granted: true,
        }
    }
    if candidate_term == node.current_term {
        if node.voted_for == 0 || node.voted_for == candidate_id {
            ret RequestVoteResult {
                term: node.current_term,
                vote_granted: true,
            }
        }
    }
    ret RequestVoteResult {
        term: node.current_term,
        vote_granted: false,
    }
}

pub fn raft_handle_append_entries(node: RaftNode, leader_term: i64, leader_commit: i64) AppendEntriesResult {
    if leader_term < node.current_term {
        ret AppendEntriesResult {
            term: node.current_term,
            success: false,
        }
    }
    ret AppendEntriesResult {
        term: leader_term,
        success: true,
    }
}

pub fn raft_calculate_quorum(cluster_size: i32) i32 {
    ret (cluster_size / 2) + 1
}

pub fn raft_become_leader(node: RaftNode) RaftNode {
    ret RaftNode {
        node_id: node.node_id,
        current_term: node.current_term,
        voted_for: node.voted_for,
        role: RaftRole::Leader,
        commit_index: node.commit_index,
        cluster_size: node.cluster_size,
        last_heartbeat_time: time_now_nanos(),
        votes_received: node.votes_received,
    }
}

pub fn raft_append_log(node: RaftNode, entry_count: i64) RaftNode {
    val new_commit = node.commit_index + entry_count
    ret RaftNode {
        node_id: node.node_id,
        current_term: node.current_term,
        voted_for: node.voted_for,
        role: node.role,
        commit_index: new_commit,
        cluster_size: node.cluster_size,
        last_heartbeat_time: time_now_nanos(),
        votes_received: node.votes_received,
    }
}

pub fn raft_is_heartbeat_timed_out(node: RaftNode, timeout_nanos: i64) bool {
    val now = time_now_nanos()
    val elapsed = now - node.last_heartbeat_time
    ret elapsed > timeout_nanos
}
