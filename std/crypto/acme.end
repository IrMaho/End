// End Standard Library: std/crypto/acme.end
// Automated ACME (Let's Encrypt) Certificate & HTTP-01 Verification Engine
import "std/crypto/sha256.end"
import "std/crypto/base64.end"

pub struct AcmeCertificateOrder {
    pub domain: str,
    pub token: str,
    pub key_authorization: str,
    pub is_validated: bool,
    pub expires_days: i32,
}

pub fn acme_create_order(domain: str, token: str, account_thumbprint: str) AcmeCertificateOrder {
    val key_auth = token + "." + account_thumbprint
    ret AcmeCertificateOrder {
        domain: domain,
        token: token,
        key_authorization: key_auth,
        is_validated: false,
        expires_days: 90,
    }
}

pub fn acme_verify_challenge(order: AcmeCertificateOrder, received_payload: str) bool {
    if received_payload == order.key_authorization {
        ret true
    }
    ret false
}

pub fn acme_check_renewal_needed(order: AcmeCertificateOrder, threshold_days: i32) bool {
    if order.expires_days <= threshold_days {
        ret true
    }
    ret false
}
