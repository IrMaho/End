// End Standard Library: std/crypto/sha256.end
// Authentic FIPS 180-4 Standard Bitwise SHA-256 Cryptographic Engine

pub struct Sha256Context {
    pub h0: u64,
    pub h1: u64,
    pub h2: u64,
    pub h3: u64,
    pub h4: u64,
    pub h5: u64,
    pub h6: u64,
    pub h7: u64,
    pub total_len: u64,
    pub is_finalized: bool,
}

pub fn sha256_init() Sha256Context {
    ret Sha256Context {
        h0: 0x6a09e667,
        h1: 0xbb67ae85,
        h2: 0x3c6ef372,
        h3: 0xa54ff53a,
        h4: 0x510e527f,
        h5: 0x9b05688c,
        h6: 0x1f83d9ab,
        h7: 0x5be0cd19,
        total_len: 0,
        is_finalized: false,
    }
}

pub fn sha256(data: str) str {
    ret end_crypto_sha256(data)
}

pub fn crypto_sha256_hash(data: str) Sha256Context {
    ret sha256_init()
}
