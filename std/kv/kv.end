// End Standard Library: std/kv/kv.end
// 💾 EndKV: Real In-Memory Key-Value Database & Storage Engine

import "../collections/map.end"

pub st KvDatabase {
    name: str,
    map: HashMap,
}

pub fn kv_database_open(name: str) KvDatabase {
    ret KvDatabase {
        name: name,
        map: map_create(32),
    }
}

pub fn kv_set(db: KvDatabase, key: str, value: str) void {
    map_set(db.map, key, value)
}

pub fn kv_get(db: KvDatabase, key: str) str {
    ret map_get(db.map, key)
}

pub fn kv_has(db: KvDatabase, key: str) bool {
    ret map_has(db.map, key)
}

pub fn kv_delete(db: KvDatabase, key: str) bool {
    ret map_delete(db.map, key)
}

pub fn kv_count(db: KvDatabase) i64 {
    ret map_len(db.map)
}

pub fn kv_close(db: KvDatabase) void {
    map_free(db.map)
}
