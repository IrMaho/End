// End Standard Library: std/async/fiber.end
// High-Performance Event-Driven Async Event Loop & Non-Blocking Poller

pub struct EventLoop {
    pub handle: i64,
    pub is_active: bool,
}

pub fn event_loop_create() EventLoop {
    val h = end_event_loop_create() as i64
    ret EventLoop {
        handle: h,
        is_active: true,
    }
}

pub fn event_loop_add(ev_loop: EventLoop, sock_fd: i64) void {
    end_event_loop_add(ev_loop.handle, sock_fd)
}

pub fn event_loop_poll(ev_loop: EventLoop, timeout_ms: i32) i32 {
    ret end_event_loop_poll(ev_loop.handle, timeout_ms) as i32
}

pub fn event_loop_get_ready_fd(ev_loop: EventLoop, index: i32) i64 {
    ret end_event_loop_get_ready(ev_loop.handle, index)
}

pub fn event_loop_destroy(ev_loop: EventLoop) void {
    end_event_loop_destroy(ev_loop.handle)
}
