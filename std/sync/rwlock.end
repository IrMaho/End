// 🧵 End Language: std/sync/rwlock.end
// Native Reader-Writer Lock with Nanosecond Priority (pthread_rwlock / SRWLOCK)

pub st RwLock {
    handle: i64,
    reader_count: i32,
    is_writer_active: bool,
    total_reads: i64,
    total_writes: i64,
}

pub fn rwlock_create() RwLock {
    val h = end_rwlock_create()
    ret RwLock {
        handle: h,
        reader_count: 0,
        is_writer_active: false,
        total_reads: 0,
        total_writes: 0,
    }
}

pub fn rwlock_read_lock(lock: RwLock) RwLock {
    end_rwlock_read_lock(lock.handle)
    ret RwLock {
        handle: lock.handle,
        reader_count: lock.reader_count + 1,
        is_writer_active: lock.is_writer_active,
        total_reads: lock.total_reads + 1,
        total_writes: lock.total_writes,
    }
}

pub fn rwlock_read_unlock(lock: RwLock) RwLock {
    end_rwlock_read_unlock(lock.handle)
    ret RwLock {
        handle: lock.handle,
        reader_count: lock.reader_count - 1,
        is_writer_active: lock.is_writer_active,
        total_reads: lock.total_reads,
        total_writes: lock.total_writes,
    }
}

pub fn rwlock_write_lock(lock: RwLock) RwLock {
    end_rwlock_write_lock(lock.handle)
    ret RwLock {
        handle: lock.handle,
        reader_count: lock.reader_count,
        is_writer_active: true,
        total_reads: lock.total_reads,
        total_writes: lock.total_writes + 1,
    }
}

pub fn rwlock_write_unlock(lock: RwLock) RwLock {
    end_rwlock_write_unlock(lock.handle)
    ret RwLock {
        handle: lock.handle,
        reader_count: lock.reader_count,
        is_writer_active: false,
        total_reads: lock.total_reads,
        total_writes: lock.total_writes,
    }
}

pub fn rwlock_destroy(lock: RwLock) void {
    end_rwlock_destroy(lock.handle)
}
