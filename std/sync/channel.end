// End Standard Library: std/sync/channel.end
// Multi-Producer Single-Consumer (MPSC) CSP Thread-Safe Ring-Buffer Channel

pub struct MpscQueue {
    pub handle: i64,
    pub capacity: i32,
    pub is_closed: bool,
}

pub fn mpsc_create(capacity: i32) MpscQueue {
    val h = end_channel_create(capacity)
    ret MpscQueue {
        handle: h,
        capacity: capacity,
        is_closed: false,
    }
}

pub fn mpsc_send(chan: MpscQueue, item: str) bool {
    if chan.is_closed {
        ret false
    }
    val res = end_channel_send(chan.handle, item)
    if res == 1 {
        ret true
    }
    ret false
}

pub fn mpsc_recv(chan: MpscQueue) str {
    ret end_channel_recv(chan.handle)
}

pub fn mpsc_pending_count(chan: MpscQueue) i32 {
    ret end_channel_pending(chan.handle) as i32
}

pub fn mpsc_close(chan: MpscQueue) void {
    end_channel_close(chan.handle)
}
