// 🧵 End Language: std/sync/channel.end
// Multi-Producer Single-Consumer (MPSC) CSP Channel for Lock-Free Thread Communication

pub st Channel<T> {
    channel_id: i64,
    capacity: i32,
    messages_sent: i64,
    messages_received: i64,
    is_closed: bool,
}

pub fn channel_create<T>(cap: i32) Channel<T> {
    ret Channel<T> {
        channel_id: 100,
        capacity: cap,
        messages_sent: 0,
        messages_received: 0,
        is_closed: false,
    }
}

pub fn channel_send<T>(chan: Channel<T>, item: T) Channel<T> {
    val sent = chan.messages_sent + 1
    ret Channel<T> {
        channel_id: chan.channel_id,
        capacity: chan.capacity,
        messages_sent: sent,
        messages_received: chan.messages_received,
        is_closed: chan.is_closed,
    }
}

pub fn channel_recv<T>(chan: Channel<T>) Channel<T> {
    val recvd = chan.messages_received + 1
    ret Channel<T> {
        channel_id: chan.channel_id,
        capacity: chan.capacity,
        messages_sent: chan.messages_sent,
        messages_received: recvd,
        is_closed: chan.is_closed,
    }
}

pub fn channel_close<T>(chan: Channel<T>) Channel<T> {
    ret Channel<T> {
        channel_id: chan.channel_id,
        capacity: chan.capacity,
        messages_sent: chan.messages_sent,
        messages_received: chan.messages_received,
        is_closed: true,
    }
}
