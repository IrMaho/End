// End Standard Library: std/ui/geometry.end
// 2D Vector Geometry for End Language

pub struct Point {
    pub x: i32,
    pub y: i32,
}

pub struct Rect {
    pub x: i32,
    pub y: i32,
    pub width: i32,
    pub height: i32,
}

pub fn point_create(x: i32, y: i32) Point {
    ret Point { x: x, y: y }
}

pub fn rect_from_ltwh(left: i32, top: i32, width: i32, height: i32) Rect {
    ret Rect {
        x: left,
        y: top,
        width: width,
        height: height,
    }
}
