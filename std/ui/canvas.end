// End Standard Library: std/ui/canvas.end
// Native High-Performance 120 FPS Direct Canvas & Alpha Compositor Engine
import "std/ui/color.end"
import "std/ui/geometry.end"

pub struct Canvas {
    pub handle: i64,
    pub width: i32,
    pub height: i32,
}

pub fn canvas_create(width: i32, height: i32) Canvas {
    val h = end_ui_canvas_create(width, height)
    ret Canvas {
        handle: h,
        width: width,
        height: height,
    }
}

pub fn canvas_clear(c: Canvas, col: Color) void {
    val pixel_u32 = color_to_u32(col)
    end_ui_canvas_clear(c.handle, pixel_u32)
}

pub fn canvas_draw_rect(c: Canvas, r: Rect, col: Color) void {
    val pixel_u32 = color_to_u32(col)
    end_ui_canvas_draw_rect(c.handle, r.x, r.y, r.width, r.height, pixel_u32)
}

pub fn canvas_draw_circle(c: Canvas, cx: i32, cy: i32, radius: i32, col: Color) void {
    val pixel_u32 = color_to_u32(col)
    end_ui_canvas_draw_circle(c.handle, cx, cy, radius, pixel_u32)
}

pub fn canvas_get_pixel(c: Canvas, x: i32, y: i32) u32 {
    ret end_ui_canvas_get_pixel(c.handle, x, y)
}

pub fn canvas_destroy(c: Canvas) void {
    end_ui_canvas_destroy(c.handle)
}
