// End Standard Library: std/ui/color.end
// Modern High-Precision Color & Gradient System for End Language

pub struct Color {
    pub r: u8,
    pub g: u8,
    pub b: u8,
    pub a: u8,
}

pub fn color_rgba(r: u8, g: u8, b: u8, a: u8) Color {
    ret Color { r: r, g: g, b: b, a: a }
}

pub fn color_rgb(r: u8, g: u8, b: u8) Color {
    ret Color { r: r, g: g, b: b, a: 255 }
}

pub fn color_to_u32(col: Color) u32 {
    val pixel_val: u32 = ((col.a as u32) << 24) | ((col.r as u32) << 16) | ((col.g as u32) << 8) | (col.b as u32)
    ret pixel_val
}

pub fn color_cyan_neon() Color { ret color_rgba(0, 245, 255, 255) }
pub fn color_violet_neon() Color { ret color_rgba(180, 0, 255, 255) }
pub fn color_dark_obsidian() Color { ret color_rgba(15, 18, 25, 255) }
pub fn color_white() Color { ret color_rgba(255, 255, 255, 255) }
pub fn color_black() Color { ret color_rgba(0, 0, 0, 255) }
