// End Standard Library: std/json/json.end
// Native JSON Object Builder & Serializer

st JsonObject {
    buffer: str,
    field_count: i32,
}

fn json_object_new() JsonObject {
    ret JsonObject {
        buffer: "{}",
        field_count: 0,
    }
}

fn json_format_pair(key: str, val: str) str {
    ret val
}
