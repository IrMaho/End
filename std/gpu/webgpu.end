// ?? End Language: std/gpu/webgpu.end
// Pure Native WebGPU & Vulkan GPU Compute / Graphics Abstraction

pub enum GpuBackendType {
    Vulkan,
    Metal,
    DirectX12,
    WebGPU,
}

pub enum BufferUsage {
    Storage,
    Uniform,
    Vertex,
    Index,
    CopySrc,
    CopyDst,
}

pub st GpuDevice {
    backend: GpuBackendType,
    max_compute_workgroups: i32,
    is_active: bool,
}

pub st GpuBuffer {
    size_bytes: i64,
    usage: BufferUsage,
    is_mapped: bool,
}

pub st ComputePipeline {
    shader_entry_point: str,
    workgroup_size_x: i32,
    workgroup_size_y: i32,
    workgroup_size_z: i32,
    is_compiled: bool,
}

pub st CommandEncoder {
    dispatches_recorded: i32,
}

pub fn gpu_create_device(backend: GpuBackendType) GpuDevice {
    ret GpuDevice {
        backend: backend,
        max_compute_workgroups: 65535,
        is_active: true,
    }
}

pub fn gpu_create_buffer(device: GpuDevice, size: i64, usage: BufferUsage) GpuBuffer {
    ret GpuBuffer {
        size_bytes: size,
        usage: usage,
        is_mapped: false,
    }
}

pub fn gpu_create_compute_pipeline(device: GpuDevice, entry_point: str) ComputePipeline {
    ret ComputePipeline {
        shader_entry_point: entry_point,
        workgroup_size_x: 64,
        workgroup_size_y: 1,
        workgroup_size_z: 1,
        is_compiled: true,
    }
}

pub fn gpu_create_command_encoder(device: GpuDevice) CommandEncoder {
    ret CommandEncoder {
        dispatches_recorded: 0,
    }
}

pub fn gpu_dispatch_compute(encoder: CommandEncoder, pipeline: ComputePipeline, x: i32, y: i32, z: i32) CommandEncoder {
    ret CommandEncoder {
        dispatches_recorded: encoder.dispatches_recorded + 1,
    }
}
