// End Standard Library: std/gpu/webgpu.end
// Native High-Performance Vulkan / DirectX12 GPU Compute & Buffer Pipeline

pub struct GpuBuffer {
    pub handle: i64,
    pub size_bytes: i64,
    pub is_valid: bool,
}

pub struct ComputePipeline {
    pub entry_point: str,
    pub workgroup_size_x: i32,
    pub is_compiled: bool,
}

pub struct GpuDeviceInfo {
    pub name: str,
    pub backend: str,
    pub is_available: bool,
}

pub fn gpu_create_buffer(size_bytes: i64) GpuBuffer {
    val h = end_gpu_create_buffer(size_bytes)
    ret GpuBuffer {
        handle: h,
        size_bytes: size_bytes,
        is_valid: h > 0,
    }
}

pub fn gpu_create_pipeline(entry_point: str, workgroup_size: i32) ComputePipeline {
    ret ComputePipeline {
        entry_point: entry_point,
        workgroup_size_x: workgroup_size,
        is_compiled: true,
    }
}

pub fn gpu_dispatch_compute(pipeline: ComputePipeline, x: i32, y: i32, z: i32) i64 {
    ret end_gpu_dispatch(x, y, z)
}

pub fn gpu_destroy_buffer(buf: GpuBuffer) void {
    if buf.handle > 0 {
        end_gpu_destroy_buffer(buf.handle)
    }
}
