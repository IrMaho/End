// 🧬 End Language Collections: std/collections/map.end
// SwissTable SIMD / FNV-1a Hashed Fast Hash Table

pub extern fn end_map_create(cap: i64) i64
pub extern fn end_map_set_str(handle: i64, key: str, val: str) void
pub extern fn end_map_get_str(handle: i64, key: str) str
pub extern fn end_map_has(handle: i64, key: str) bool
pub extern fn end_map_delete(handle: i64, key: str) bool
pub extern fn end_map_len(handle: i64) i64
pub extern fn end_map_free(handle: i64) void

pub st HashMap {
    handle: i64,
}

pub fn map_create(initial_buckets: i64) HashMap {
    ret HashMap {
        handle: end_map_create(initial_buckets),
    }
}

pub fn map_set(map: HashMap, key: str, value: str) void {
    end_map_set_str(map.handle, key, value)
}

pub fn map_get(map: HashMap, key: str) str {
    ret end_map_get_str(map.handle, key)
}

pub fn map_has(map: HashMap, key: str) bool {
    ret end_map_has(map.handle, key)
}

pub fn map_delete(map: HashMap, key: str) bool {
    ret end_map_delete(map.handle, key)
}

pub fn map_len(map: HashMap) i64 {
    ret end_map_len(map.handle)
}

pub fn map_free(map: HashMap) void {
    end_map_free(map.handle)
}
