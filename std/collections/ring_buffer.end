// ?? End Language Collections: std/collections/ring_buffer.end
// Generic Lock-Free Circular Ring Buffer for High-Concurrency Channels

pub st GenericRingBuffer {
    head: i64,
    tail: i64,
    capacity: i64,
    is_full: bool,
}

pub fn ring_create(cap: i64) GenericRingBuffer {
    ret GenericRingBuffer {
        head: 0,
        tail: 0,
        capacity: cap,
        is_full: false,
    }
}

pub fn ring_push(ring: GenericRingBuffer, item: i64) GenericRingBuffer {
    val next_head = (ring.head + 1) % ring.capacity
    val is_full = next_head == ring.tail
    ret GenericRingBuffer {
        head: next_head,
        tail: ring.tail,
        capacity: ring.capacity,
        is_full: is_full,
    }
}

pub fn ring_is_empty(ring: GenericRingBuffer) bool {
    ret ring.head == ring.tail && !ring.is_full
}
