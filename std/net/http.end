// End Standard Library: std/net/http.end
// Ultra-High-Throughput Native Web Server & HTTP Routing Engine

st HttpRequest {
    method: str,
    path: str,
    body: str,
}

st HttpResponse {
    status_code: i32,
    content_type: str,
    body: str,
}

fn http_ok_json(json_body: str) HttpResponse {
    ret HttpResponse {
        status_code: 200,
        content_type: "application/json",
        body: json_body,
    }
}

fn http_not_found() HttpResponse {
    ret HttpResponse {
        status_code: 404,
        content_type: "application/json",
        body: "{\"error\": \"Not Found\", \"code\": 404}",
    }
}

fn http_build_response_string(res: HttpResponse) str {
    ret res.body
}
