// End Standard Library: std/net/socket.end
// Native High-Performance Cross-Platform TCP Socket Networking

pub struct TcpListener {
    pub handle: i64,
    pub port: i32,
    pub is_listening: bool,
}

pub struct TcpStream {
    pub handle: i64,
    pub peer_addr: str,
    pub is_connected: bool,
}

pub fn tcp_listener_bind(port: i32) TcpListener {
    val h: i64 = end_net_tcp_listen(port, 128)
    ret TcpListener {
        handle: h,
        port: port,
        is_listening: h >= 0,
    }
}

pub fn tcp_listener_accept(listener: TcpListener) TcpStream {
    if listener.is_listening == false {
        ret TcpStream {
            handle: -1,
            peer_addr: "",
            is_connected: false,
        }
    }
    val client_h: i64 = end_net_tcp_accept(listener.handle)
    ret TcpStream {
        handle: client_h,
        peer_addr: "client",
        is_connected: client_h >= 0,
    }
}

pub fn tcp_listener_set_nonblocking(listener: TcpListener, is_nonblocking: bool) bool {
    if is_nonblocking == true {
        val r1 = end_net_set_nonblocking(listener.handle, 1)
        if r1 == 1 {
            ret true
        }
        ret false
    }
    val r0 = end_net_set_nonblocking(listener.handle, 0)
    if r0 == 1 {
        ret true
    }
    ret false
}

pub fn tcp_connect(host: str, port: i32) TcpStream {
    val h: i64 = end_net_tcp_connect(host, port)
    ret TcpStream {
        handle: h,
        peer_addr: host,
        is_connected: h >= 0,
    }
}

pub fn tcp_stream_set_nonblocking(stream_conn: TcpStream, is_nonblocking: bool) bool {
    if is_nonblocking == true {
        val r1 = end_net_set_nonblocking(stream_conn.handle, 1)
        if r1 == 1 {
            ret true
        }
        ret false
    }
    val r0 = end_net_set_nonblocking(stream_conn.handle, 0)
    if r0 == 1 {
        ret true
    }
    ret false
}

pub fn tcp_stream_write(stream_conn: TcpStream, response_bytes: str) i64 {
    if stream_conn.is_connected == false {
        ret 0
    }
    ret end_net_tcp_send(stream_conn.handle, response_bytes, -1)
}

pub fn tcp_stream_read(stream_conn: TcpStream, max_bytes: i32) str {
    if stream_conn.is_connected == false {
        ret ""
    }
    ret end_net_tcp_recv(stream_conn.handle, max_bytes)
}

pub fn tcp_stream_close(stream_conn: TcpStream) void {
    if stream_conn.handle >= 0 {
        end_net_tcp_close(stream_conn.handle)
    }
}

pub fn tcp_listener_close(listener: TcpListener) void {
    if listener.handle >= 0 {
        end_net_tcp_close(listener.handle)
    }
}
