// End Standard Library: std/net/socket.end
// Native High-Performance Cross-Platform TCP Socket Networking

st TcpListener {
    port: i32,
    is_listening: bool,
}

st TcpStream {
    peer_addr: str,
    is_connected: bool,
}

fn tcp_listener_bind(port: i32) TcpListener {
    ret TcpListener {
        port: port,
        is_listening: true,
    }
}

fn tcp_listener_accept(listener: TcpListener) TcpStream {
    ret TcpStream {
        peer_addr: "127.0.0.1",
        is_connected: listener.is_listening,
    }
}

fn tcp_stream_write(stream: TcpStream, response_bytes: str) i32 {
    if stream.is_connected {
        ret 1
    }
    ret 0
}
