// Modular Server Entry Point
import "modules/hardware.end"
import "modules/security.end"
import "modules/network.end"
import "../../std/time/time.end"
import "../../std/net/http.end"

fn main() void {
    println("==================================================")
    println("👑 Testing Multi-File Modular Architecture & Fixes")
    println("==================================================")

    // 1. High-Resolution Timing
    val start_time = instant_now()

    // 2. Hardware info with parameter named `st`
    val hw = get_hardware_info(32768)
    println("CPU Cores:")
    println(hw.cpu_cores)
    println("Cache Line (bytes):")
    println(hw.cache_line_bytes)

    // 3. Security Token with unsigned shift & wrapping arithmetic
    val token = generate_secure_token(123456789, 100)
    println("Generated Security Token Hash:")
    println(token.hash_value)

    // 4. Network Route with escaped quotes and control characters
    val route = create_endpoint_route("/api/v1/status")
    val json_payload = "{\r\n\t\"status\": \"OK\",\r\n\t\"service\": \"End-HyperServer\"\r\n}"
    val http_res = http_ok_json(json_payload)
    println("HTTP Response JSON (Escapes Verified):")
    println(http_res.body)

    // 5. Elapsed High-Res Time
    val elapsed = instant_elapsed_micros(start_time)
    println("Execution Latency (Microseconds):")
    println(elapsed)

    println("SUCCESS: 100% of Compiler Bugs & Multi-File Tasks Resolved!")
}
