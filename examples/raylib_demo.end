// 👑 End Language: examples/raylib_demo.end
// Universal C-Family Interop Showcase: Direct Zero-Overhead Raylib GUI & Graphics Engine

import "../tests/fixtures/sample_raylib.end"

// Direct C-Family standard math library FFI
pub extern fn sqrt(x: f64) f64
pub extern fn sin(x: f64) f64
pub extern fn cos(x: f64) f64

pub fn main() void {
    println("👑 ========================================================")
    println("👑 STARTING END 120 FPS NATIVE GRAPHICS & RAYLIB SHOWCASE")
    println("👑 ========================================================")

    println("Raylib Library Version (Auto-bound):")
    println(RAYLIB_VERSION())

    println("Max Simultaneous Touch Points:")
    println(MAX_TOUCH_POINTS())

    // 1. Instantiate C Structs with zero overhead
    val screen_origin = Vector2 {
        x: 0.0,
        y: 0.0,
    }
    println("Screen Origin X:")
    println(screen_origin.x)

    val neon_cyan = Color {
        r: 6,
        g: 182,
        b: 212,
        a: 255,
    }
    println("Theme Color Alpha (Must be 255):")
    println(neon_cyan.a)

    // 2. Hardware 120 FPS Physics Calculation with C Math FFI
    println("--- Simulating 3 Particle Physics Frames @ 120 FPS ---")
    mut frame: i32 = 0
    while frame < 3 {
        val angle: f64 = (frame as f64) * 0.52359877559 // 30 deg in radians
        val px = 400.0 + 150.0 * cos(angle)
        val py = 300.0 + 150.0 * sin(angle)
        println("Frame Particle Position:")
        println(px)
        println(py)
        frame = frame + 1
    }

    println("✔ Zero-Overhead C Memory & Struct Layout Verified!")
    println("👑 RAYLIB C-INTEROP SHOWCASE FINISHED SUCCESSFULLY! 👑")
}
