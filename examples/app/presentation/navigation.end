// ============================================================================
// End DevOps & AI Workspace — Presentation: App Navigation & TopBar/Sidebar
// Location: examples/app/presentation/navigation.end
// Demonstrates: Modern Multi-line String Interpolation & Clean Architecture
// ============================================================================

import "../state/app_state.end"

pub fn render_sidebar_layout(active: ActivePage) -> str {
    val current_name = page_to_string(active);
    ret """┌──────────────────────────────────────────┐
│ 👑 DevOps & AI Workspace (v2.0.0)         │
├──────────────────────────────────────────┤
│  [1] Dashboard                           │
│  [2] Projects                            │
│  [3] Project Details                     │
│  [4] Tasks / Kanban                      │
│  [5] Code Workspace (IDE)                │
│  [6] Event Monitor                       │
│  [7] Architecture Graph                  │
│  [8] Analytics & Telemetry               │
│  [9] Team & Users                        │
│ [10] Notifications & Activity            │
│ [11] Settings & Security Policies        │
│ [12] System & Performance Monitor        │
│ [13] AI Agent Workspace                  │
│ [14] Feature Explorer                    │
│ [15] Dependency Graph                    │
├──────────────────────────────────────────┤
│ Active View: {current_name} 
└──────────────────────────────────────────┘""";
}

pub fn render_topbar_layout(user_email: str, notifs: i64) -> str {
    ret """────────────────────────────────────────────────────────────────────────────
 👑 End DevOps Workspace | User: {user_email} | Alerts: ({notifs}) | Status: \x1b[1;32mONLINE\x1b[0m
────────────────────────────────────────────────────────────────────────────""";
}

pub struct AppNavigationLayout {
    pub app_title: str,
    pub version: str,

    pub fn render_sidebar(&self, active: ActivePage) -> str {
        ret render_sidebar_layout(active);
    }

    pub fn render_topbar(&self, user_email: str, notifs: i64) -> str {
        ret render_topbar_layout(user_email, notifs);
    }
}

pub fn create_navigation_layout() -> AppNavigationLayout {
    ret AppNavigationLayout {
        app_title: "DevOps & AI Workspace",
        version: "2.0.0"
    };
}
