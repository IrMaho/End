// ============================================================================
// End DevOps & AI Workspace — Contracts: Storage Provider Interfaces
// Location: examples/app/contracts/storage.end
// Demonstrates: Modern Trait with Void Mutation & Disposal Methods
// ============================================================================

pub enum StorageMedium {
    InMemory,
    LocalDisk,
    CloudObjectStore
}

// 👑 Modern Storage Trait: put and delete are pure VOID mutations (no dummy return needed!)
pub trait IStorageProvider {
    fn put(key: str, value: str);
    fn get(key: str) -> str;
    fn delete(key: str);
    fn exists(key: str) -> bool;
    fn get_medium_type() -> StorageMedium;
}

pub struct StorageAuditEntry {
    pub operation: str,
    pub key: str,
    pub size_bytes: i64,
    pub success: bool,
}

pub fn create_storage_audit(op: str, key: str, sz: i64, ok: bool) -> StorageAuditEntry {
    ret StorageAuditEntry {
        operation: op,
        key: key,
        size_bytes: sz,
        success: ok
    };
}
