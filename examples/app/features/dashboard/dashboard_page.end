// End DevOps & AI Workspace — Feature 1: Dashboard Page
// Location: examples/app/features/dashboard/dashboard_page.end
// Demonstrates: Real Application State Aggregation & Composite UI
// ============================================================================

import "../../domain/project.end"
import "../../domain/metrics.end"
import "../../presentation/components.end"

fn render_dashboard_view(p: Project, t: SystemTelemetry, a: ArchitectureHealthMetric) -> String {
    val header = "╔══════════════════════════════════════════════════════════════════════════╗\n"
               + "║                       🚀 SYSTEM OVERVIEW DASHBOARD                       ║\n"
               + "╚══════════════════════════════════════════════════════════════════════════╝";

    val c1 = create_metric_card("Project Health", "98.5%", "2.1%", true);
    val c2 = create_metric_card("Event Throughput", "24,500/s", "14.2%", true);
    val c3 = create_metric_card("Active Tasks", "38 / 45 Done", "84.4%", true);
    val c4 = create_metric_card("P99 Event Latency", "38 µs", "5.0%", true);

    val cards_row = c1.render() + "\n" + c2.render() + "\n" + c3.render() + "\n" + c4.render();

    val arch_summary = "═══ ARCHITECTURE HEALTH & SOLID AUDIT ═══\n"
                     + "  • Total Modules: 24 | Circular Dependencies: 0 (CLEAN)\n"
                     + "  • Average Cohesion: 0.95 | Average Coupling: 0.12\n"
                     + "  • Compiler Invariant Safety: 100% VERIFIED\n"
                     + "══════════════════════════════════════════════════════════════════════════";

    val live_activity = "═══ RECENT REAL-TIME ACTIVITY ═══\n"
                      + "  ● [10:14:22] TaskCompleted -> Task #104 (AST Lowering to MIR)\n"
                      + "  ● [10:14:25] ProjectMetricsUpdated -> Health recalculated to 98.5%\n"
                      + "  ● [10:14:30] NotificationDispatched -> Sent to lead_architect\n"
                      + "══════════════════════════════════════════════════════════════════════════";

    return header + "\n\n" + cards_row + "\n\n" + arch_summary + "\n\n" + live_activity;
}

class DashboardPage {
    project: Project;
    telemetry: SystemTelemetry;
    arch_health: ArchitectureHealthMetric;

    fn render_view() -> String {
        return render_dashboard_view(self.project, self.telemetry, self.arch_health);
    }
}

fn create_dashboard_page(p: Project, t: SystemTelemetry, a: ArchitectureHealthMetric) -> DashboardPage {
    return DashboardPage {
        project: p,
        telemetry: t,
        arch_health: a
    };
}
