// ============================================================================
// End DevOps & AI Workspace — Feature: Dashboard Page
// Location: examples/app/features/dashboard/dashboard_page.end
// Demonstrates: Feature-Oriented Architecture, Modules & Declarative UI
// ============================================================================

use "../../domain/project.end"
use "../../domain/metrics.end"
use "../../presentation/components.end"

pub feature DashboardFeature @version("2.0.0") @owner("analytics_team") {
    depends: [ProjectDomain, MetricsDomain];
}

pub fn render_dashboard_view(p: Project, t: SystemTelemetry, a: ArchitectureHealthMetric) -> str {
    val header = """╔══════════════════════════════════════════════════════════════════════════╗
║                       🚀 SYSTEM OVERVIEW DASHBOARD                       ║
╚══════════════════════════════════════════════════════════════════════════╝""";

    val c1 = create_metric_card("Project Health", "98.5%", "2.1%", true);
    val c2 = create_metric_card("Event Throughput", "24,500/s", "14.2%", true);
    val c3 = create_metric_card("Active Tasks", "38 / 45 Done", "84.4%", true);
    val c4 = create_metric_card("P99 Event Latency", "38 µs", "5.0%", true);

    val cards_row = "{c1.render()}\n{c2.render()}\n{c3.render()}\n{c4.render()}";

    val arch_summary = """═══ ARCHITECTURE HEALTH & SOLID AUDIT ═══
  • Total Modules: 24 | Circular Dependencies: 0 (CLEAN)
  • Average Cohesion: 0.95 | Average Coupling: 0.12
  • Compiler Invariant Safety: 100% VERIFIED
══════════════════════════════════════════════════════════════════════════""";

    val live_activity = """═══ RECENT REAL-TIME ACTIVITY ═══
  ● [10:14:22] TaskCompleted -> Task #104 (AST Lowering to MIR)
  ● [10:14:25] ProjectMetricsUpdated -> Health recalculated to 98.5%
  ● [10:14:30] NotificationDispatched -> Sent to lead_architect
══════════════════════════════════════════════════════════════════════════""";

    ret "{header}\n\n{cards_row}\n\n{arch_summary}\n\n{live_activity}";
}

pub struct DashboardPage {
    pub project: Project,
    pub telemetry: SystemTelemetry,
    pub arch_health: ArchitectureHealthMetric,

    pub fn render_view(&self) -> str {
        ret render_dashboard_view(self.project, self.telemetry, self.arch_health);
    }
}

pub fn create_dashboard_page(p: Project, t: SystemTelemetry, a: ArchitectureHealthMetric) -> DashboardPage {
    ret DashboardPage {
        project: p,
        telemetry: t,
        arch_health: a
    };
}
