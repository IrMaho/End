// ============================================================================
// End DevOps & AI Workspace — Services: Polymorphic Notification Providers
// Location: examples/app/services/notification_service.end
// Demonstrates: Polymorphic Provider Implementations & Strategy Pattern
// ============================================================================

import "../contracts/notification.end"

class EmailNotificationService inherits INotificationService {
    smtp_host: String;
    sent_count: i64;

    fn send_notification(msg: NotificationMessage) -> bool {
        self.sent_count = self.sent_count + 1;
        return true;
    }

    fn get_provider_name() -> String {
        return "SMTP Email Provider (" + self.smtp_host + ")";
    }

    fn is_available() -> bool {
        return true;
    }
}

class PushNotificationService inherits INotificationService {
    gateway_url: String;
    sent_count: i64;

    fn send_notification(msg: NotificationMessage) -> bool {
        self.sent_count = self.sent_count + 1;
        return true;
    }

    fn get_provider_name() -> String {
        return "WebPush & APNS Gateway";
    }

    fn is_available() -> bool {
        return true;
    }
}

class InAppNotificationService inherits INotificationService {
    feed_buffer_size: i64;
    sent_count: i64;

    fn send_notification(msg: NotificationMessage) -> bool {
        self.sent_count = self.sent_count + 1;
        return true;
    }

    fn get_provider_name() -> String {
        return "In-App Toast & Live Feed Manager";
    }

    fn is_available() -> bool {
        return true;
    }
}

fn create_email_service(host: String) -> EmailNotificationService {
    return EmailNotificationService {
        smtp_host: host,
        sent_count: 0
    };
}

fn create_push_service() -> PushNotificationService {
    return PushNotificationService {
        gateway_url: "https://push.workspace.internal",
        sent_count: 0
    };
}

fn create_inapp_service() -> InAppNotificationService {
    return InAppNotificationService {
        feed_buffer_size: 100,
        sent_count: 0
    };
}
