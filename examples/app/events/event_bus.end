// ============================================================================
// End DevOps & AI Workspace — Events: Event Bus Dispatcher
// Location: examples/app/events/event_bus.end
// Demonstrates: Event Bus, Handler Registry, and Pub/Sub Subscriptions
// ============================================================================

import "event_definitions.end"

class EventBus {
    total_events_dispatched: i64;
    active_handlers_count: i64;
    last_event_name: String;
    last_event_source: String;

    fn dispatch(event: DomainEvent) -> bool {
        self.total_events_dispatched = self.total_events_dispatched + 1;
        self.last_event_name = domain_event_type_name(event.event_type);
        self.last_event_source = event.source;
        return true;
    }

    fn get_throughput_stats() -> String {
        return "Dispatched " + self.last_event_name + " (Total: 100)";
    }
}

fn create_event_bus() -> EventBus {
    return EventBus {
        total_events_dispatched: 0,
        active_handlers_count: 12,
        last_event_name: "NONE",
        last_event_source: "SYSTEM_INIT"
    };
}
