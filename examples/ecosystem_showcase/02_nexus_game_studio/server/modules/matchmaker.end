// ============================================================================
// GAME STUDIO MODULE: MULTIPLAYER ARENA ROOM ALLOCATOR
// ============================================================================

pub fn allocate_game_room(player_id: i64, skill_rating: i32) i64 {
    val room_seed = (player_id * 31) ^ (skill_rating * 97)
    val room_id = 1000 + (room_seed % 50)
    ret room_id
}

pub fn calculate_lobby_ping(region_code: i32) i64 {
    ret 15 + (region_code * 8)
}
