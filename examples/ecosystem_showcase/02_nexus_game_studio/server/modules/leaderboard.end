// ============================================================================
// GAME STUDIO MODULE: IN-MEMORY RANKING & HIGH SCORE ENGINE
// ============================================================================

pub fn compute_player_rank(score: i64) i32 {
    if score > 100000 { ret 1 }
    else if score > 75000 { ret 2 }
    else if score > 50000 { ret 3 }
    else if score > 25000 { ret 4 }
    ret 5
}

pub fn calculate_xp_multiplier(streak: i32) i32 {
    ret 100 + (streak * 15)
}
