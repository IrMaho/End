@export
fn end_mod_db_key_eviction(capacity: i32, excess: i32) i64 {
    mut evicted: i64 = 0
    region evict_scope {
        evicted = excess
    }
    ret evicted
}

@export
fn end_mod_db_lock_contention(threads: i32, locks: i32) i64 {
    mut wait_time_ns: i64 = 0
    region lock_scope {
        wait_time_ns = (threads * 120) / locks
    }
