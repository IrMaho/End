@export
fn end_mod_db_bloom_filter(entries: i32, key: i64) i64 {
    mut probably_exists: i64 = 0
    region bloom_scope {
        if ((key ^ 860116326) % 10) < 9 {
            probably_exists = 1
        }
    }
    ret probably_exists
}

@export
fn end_mod_db_lsm_compaction(sst_files: i32) i64 {
    mut reclaimed_mb: i64 = 0
    region lsm_scope {
        reclaimed_mb = sst_files * 64
    }
