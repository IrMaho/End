// 👑 End Language Official Native GUI Installer (v0.4.0-alpha)
// 100% Written in Pure End with 120 FPS Native Glassmorphism Canvas

import "std/ui/window.end"
import "std/ui/canvas.end"
import "std/time/time.end"

pub st InstallerState {
    step: i32,              // 0: Welcome, 1: Installing, 2: Complete
    progress_pct: f64,
    install_path: str,
    status_text: str,
    neon_glow_phase: f64,
    is_path_registered: bool,
}

pub fn installer_state_create() InstallerState {
    ret InstallerState {
        step: 0,
        progress_pct: 0.0,
        install_path: "C:\\Program Files\\EndLanguage",
        status_text: "Ready to install End Toolchain & Standard Libraries",
        neon_glow_phase: 0.0,
        is_path_registered: true,
    }
}

// 120 FPS Render Loop for Glassmorphism Installer Window
pub fn installer_render_frame(state: InstallerState, canvas: CanvasContext) InstallerState {
    // 1. Clear with Deep Obsidian Background (#0A0E14)
    canvas_clear(canvas, 10, 14, 20);

    // 2. Draw Ambient Neon Radial Blur Header
    val phase = state.neon_glow_phase + 0.05;
    val glow_intensity = 0.5 + (0.5 * sin_f64(phase));
    canvas_draw_neon_glow(canvas, 300, 80, 120, glow_intensity, 88, 166, 255);

    // 3. Render 👑 Crown Logo & Modern Typography
    canvas_draw_text(canvas, "👑 END PROGRAMMING LANGUAGE", 140, 75, 22, 255, 255, 255);
    canvas_draw_text(canvas, "v0.4.0-alpha Global Release • Zero-GC Native Speed", 120, 105, 12, 139, 148, 158);

    // 4. Draw Glassmorphism Card Container
    canvas_draw_glass_rect(canvas, 40, 140, 520, 220, 16, 22, 34, 0.85);

    if state.step == 0 {
        // Step 0: Welcome & Path Selection
        canvas_draw_text(canvas, "Installation Destination:", 60, 170, 14, 201, 209, 217);
        canvas_draw_text_box(canvas, state.install_path, 60, 195, 480, 36, 13, 17, 23);
        canvas_draw_text(canvas, "✔ Includes: end.exe, endc.exe, Standard Library, VS Code Extension", 60, 250, 12, 63, 185, 80);
        canvas_draw_text(canvas, "✔ Automatically adds binary path to system PATH environment", 60, 275, 12, 63, 185, 80);

        // Neon Blue Action Button: "Install Now"
        canvas_draw_rounded_button(canvas, "🚀 Install End Toolchain", 160, 310, 280, 42, 31, 111, 235);
    } else if state.step == 1 {
        // Step 1: Progress Bar Animation
        canvas_draw_text(canvas, "Installing End Language Components...", 60, 170, 15, 255, 255, 255);
        canvas_draw_text(canvas, state.status_text, 60, 205, 12, 139, 148, 158);

        // Progress Bar
        canvas_draw_progress_bar(canvas, 60, 240, 480, 24, state.progress_pct, 63, 185, 80);
    } else {
        // Step 2: Completion
        canvas_draw_text(canvas, "🎉 Installation Complete!", 180, 180, 20, 63, 185, 80);
        canvas_draw_text(canvas, "Open your terminal and type 'end --version' to begin.", 100, 220, 13, 201, 209, 217);
        canvas_draw_rounded_button(canvas, "✔ Launch Antigravity Studio", 160, 280, 280, 42, 46, 160, 67);
    }

    ret InstallerState {
        step: state.step,
        progress_pct: state.progress_pct,
        install_path: state.install_path,
        status_text: state.status_text,
        neon_glow_phase: phase,
        is_path_registered: state.is_path_registered,
    }
}

pub fn main() void {
    println("👑 Launching End Language Native GUI Installer (120 FPS)...");
    val win = ui_window_create("End Language v0.4.0-alpha Installer", 600, 400);
    mut state = installer_state_create();

    while ui_window_is_open(win) {
        state = installer_render_frame(state, ui_window_get_canvas(win));
        ui_window_swap_buffers_vsync(win);
    }
}
