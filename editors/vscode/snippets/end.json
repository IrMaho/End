{
  "Function Definition": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) ${3:void} {",
      "\t$0",
      "}"
    ],
    "description": "Define a function in End Language"
  },
  "Region Block": {
    "prefix": "region",
    "body": [
      "region ${1:scope_name} {",
      "\t$0",
      "}"
    ],
    "description": "Define a deterministic zero-GC Region memory scope"
  },
  "Struct Definition": {
    "prefix": "st",
    "body": [
      "st ${1:StructName} {",
      "\t${2:field}: ${3:type},",
      "}"
    ],
    "description": "Define a Struct"
  },
  "Enum Definition": {
    "prefix": "enum",
    "body": [
      "enum ${1:EnumName} {",
      "\t${2:Variant1},",
      "\t${3:Variant2},",
      "}"
    ],
    "description": "Define an Enum / Algebraic Data Type"
  },
  "Pattern Match": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "\t.${2:Variant} => {",
      "\t\t$0",
      "\t},",
      "}"
    ],
    "description": "Exhaustive Pattern Matching"
  },
  "Parallel For Loop": {
    "prefix": "parallel",
    "body": [
      "parallel for ${1:i} in ${2:count} {",
      "\t$0",
      "}"
    ],
    "description": "Hardware-accelerated parallel loop"
  },
  "Inline Assembly Block": {
    "prefix": "asm",
    "body": [
      "asm x86_64 {",
      "\t\"${1:instruction}\"",
      "}"
    ],
    "description": "Direct Inline Assembly"
  },
  "Multi-Target Annotation": {
    "prefix": "target",
    "body": [
      "@target(\"${1:cpu}\") {",
      "\t$0",
      "}"
    ],
    "description": "Multi-Target Hardware Specialized Block"
  },
  "Print Line": {
    "prefix": "pl",
    "body": [
      "println(${1:\"message\"})"
    ],
    "description": "Print line to standard output"
  }
}
