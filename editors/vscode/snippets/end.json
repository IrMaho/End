{
  "Feature Definition": {
    "prefix": "feature",
    "body": [
      "pub feature ${1:FeatureName} @version(\"${2:1.0.0}\") @owner(\"${3:team}\") {",
      "\tdepends: [${4:Dependencies}];",
      "\t$0",
      "}"
    ],
    "description": "Define a Feature-Oriented Architecture module"
  },
  "Referrer Statement": {
    "prefix": "refer",
    "body": [
      "// Autonomous Referrer binding to Consumer Hub",
      "refer ${1:HandlerName} to ${2:ConsumerHub};"
    ],
    "description": "Inverted Referrer declaration binding provider to consumer"
  },
  "Conditional Referrer": {
    "prefix": "referwhen",
    "body": [
      "refer ${1:HandlerName} to ${2:ConsumerHub} when ${3:env == \"production\"};"
    ],
    "description": "Conditionally refer a handler to a consumer target"
  },
  "AI Agent Contract": {
    "prefix": "agent",
    "body": [
      "agent ${1:AgentName} {",
      "\tscope: \"${2:src/module}\",",
      "\tgoal: \"${3:Autonomous System Verification}\",",
      "\tconstraints: [\"${4:zero_breaking_changes}\", \"${5:smt_verified}\"]",
      "}"
    ],
    "description": "Define a First-Class AI Agent Contract"
  },
  "AI Task Contract": {
    "prefix": "task",
    "body": [
      "task ${1:TaskName} {",
      "\towner: \"${2:agent-id}\",",
      "\tstatus: \"${3:in_progress}\",",
      "\trequirement: \"${4:Decomposition of subsystem}\",",
      "\ttarget: \"${5:src/module.end}\",",
      "\tskills: [\"${6:lossless-modular-refactor}\"],",
      "\tchange_budget: [\"${7:max_files: 5}\", \"${8:max_line_delta: 200}\"]",
      "}"
    ],
    "description": "Define an AI Engineering Task Contract"
  },
  "Event Hub Definition": {
    "prefix": "hub",
    "body": [
      "pub hub ${1:EventHubName} {",
      "\tpub total_events: i64,",
      "\t$0",
      "}"
    ],
    "description": "Define a Reactive Event Hub"
  },
  "First-Class Operation": {
    "prefix": "operation",
    "body": [
      "operation ${1:OperationName}(${2:params}) -> ${3:ReturnType} {",
      "\trequires: ${4:condition};",
      "\tguarantees: ${5:post_condition};",
      "\tretry: ${6:3} times;",
      "\t$0",
      "}"
    ],
    "description": "Define an algebraic Operation with pre/post-conditions"
  },
  "Declarative UI Widget": {
    "prefix": "widget",
    "body": [
      "@widget",
      "pub fn ${1:WidgetName}(${2:props}) {",
      "\tret Container {",
      "\t\tchild: Column {",
      "\t\t\tchildren: [",
      "\t\t\t\tText(\"${3:Title}\"),",
      "\t\t\t\t$0",
      "\t\t\t]",
      "\t\t}",
      "\t};",
      "}"
    ],
    "description": "Define a 120 FPS Declarative UI Widget"
  },
  "Pythonic Function Definition": {
    "prefix": "def",
    "body": [
      "def ${1:name}(${2:params}):",
      "\t$0"
    ],
    "description": "Define a Pythonic fluid function"
  },
  "Typed Function Definition": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:params}) -> ${3:str} {",
      "\t$0",
      "}"
    ],
    "description": "Define a typed function"
  },
  "Public Function Definition": {
    "prefix": "pubfn",
    "body": [
      "pub fn ${1:name}(${2:params}) -> ${3:str} {",
      "\t$0",
      "}"
    ],
    "description": "Define an exported public function"
  },
  "Zero-GC Region Block": {
    "prefix": "region",
    "body": [
      "region ${1:FrameArena} {",
      "\t$0",
      "}"
    ],
    "description": "Define a deterministic zero-GC Region memory scope"
  },
  "Ephemeral Lease Scope": {
    "prefix": "lease",
    "body": [
      "lease val ${1:buffer} = alloc(${2:4096}) {",
      "\t$0",
      "};"
    ],
    "description": "Define an Ephemeral Resource Lease (recycled at 0 ns)"
  },
  "Struct Definition": {
    "prefix": "st",
    "body": [
      "pub struct ${1:StructName} {",
      "\tpub ${2:field}: ${3:str},",
      "}"
    ],
    "description": "Define a Struct"
  },
  "Class with Inheritance": {
    "prefix": "class",
    "body": [
      "pub class ${1:ClassName} inherits ${2:BaseContract} {",
      "\tpub ${3:field}: ${4:str},",
      "",
      "\tpub fn ${5:method_name}(self) {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Define a Class with Inheritance"
  },
  "Enum Definition": {
    "prefix": "enum",
    "body": [
      "pub enum ${1:EnumName} {",
      "\t${2:Variant1},",
      "\t${3:Variant2},",
      "}"
    ],
    "description": "Define an Enum / Algebraic Data Type"
  },
  "Pattern Match": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "\t${2:Variant1} => {",
      "\t\t$0",
      "\t},",
      "\t_ => {}",
      "}"
    ],
    "description": "Exhaustive Pattern Matching"
  },
  "Unit Test": {
    "prefix": "test",
    "body": [
      "@test(\"${1:Test Description}\")",
      "pub fn test_${2:feature}() -> bool {",
      "\t$0",
      "\tret true;",
      "}"
    ],
    "description": "Define an automated unit test with @test attribute"
  }
}
