{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "End",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#directives"
    },
    {
      "include": "#types"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.end",
          "match": "//.*$"
        },
        {
          "name": "comment.block.end",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.end",
          "match": "\\b(fn|st|struct|enum|val|mut|var|ret|return|if|else|while|for|parallel|in|match|defer|region|asm|target|import|as|pub|alloc|catch|spawn|skip)\\b"
        },
        {
          "name": "constant.language.end",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "entity.name.tag.directive.end",
          "match": "@(agent_note|alloc_bound|target|c|zig|rust|go)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.end",
          "match": "\\b(void|bool|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|f32x4|f32x8|i32x4|i32x8|str|string|Allocator|region)\\b"
        },
        {
          "name": "entity.name.type.class.end",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.end",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.end",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.end",
          "match": "\\b[0-9]+\\.[0-9]+(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.end",
          "match": "\\b[0-9]+(u8|u16|u32|u64|i8|i16|i32|i64)?\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.end",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    }
  },
  "scopeName": "source.end"
}
