{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "End",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.end",
          "match": "//.*$"
        },
        {
          "name": "comment.block.end",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.tag.decorator.end",
          "match": "@(get|post|put|delete|ws|test|bench|export|c_export|import_c|link|inline|always_inline|invariant|telemetry|comptime|watchdog|trace_fn|log_state|target|optimize|align|intrinsic|pure|effect)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.end",
          "match": "\\b(if|else|while|for|in|ret|return|break|continue|match|parallel|defer|unsafe|spawn|async|await)\\b"
        },
        {
          "name": "keyword.other.memory.end",
          "match": "\\b(region|mut|val|pure|effect|alloc|free|promote|catch|skip)\\b"
        },
        {
          "name": "keyword.declaration.end",
          "match": "\\b(pub|fn|extern|inline_c|st|struct|enum|trait|impl|asm|import|as|from|mod|module|override|extend|bridge|with|derives)\\b"
        },
        {
          "name": "constant.language.boolean.end",
          "match": "\\b(true|false|null|void)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.end",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|str|void|Box|Rc|Arc|Channel|Allocator|Result|List|HashMap|DbConnection|KvDatabase|Instant|StreamChunk|SseEvent|EndArena|SocketGuard|CircuitBreaker|TelemetryRingBuffer|WhatIfParameter|StressMetricsReport)\\b"
        },
        {
          "name": "entity.name.type.struct.end",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.end",
          "match": "\\b(println|print|end_println|inspect|trace|effects|impact|assert|alloc|free|cpu_yield|cpu_relax|cpu_sleep_ms|safe_socket_poll|high_res_time_ns|instant_now|instant_elapsed_micros|instant_elapsed_nanos|instant_elapsed_millis|time_now_nanos|time_now_micros|time_now_millis|list_create|list_push_str|list_get_str|list_len|map_create|map_set|map_get|map_has|map_delete|map_len|db_open|db_set|db_get|db_close|kv_database_open|kv_set|kv_get|kv_has|kv_delete|kv_count|kv_close|ws_handshake_accept|ws_compute_accept_key|argon2_hash_password|argon2_verify|oauth2_generate_pkce|sse_format_event|sse_chunk_encode|socket_guard_create|circuit_breaker_create|ring_buffer_create|hot_reload_store_create)\\b"
        },
        {
          "name": "entity.name.function.end",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.end",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.end",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.end",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.end",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.end",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.end",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.end",
          "match": "(\\~\\>|\\<\\+\\=|\\?\\?|\\?|val\\!|\\+|\\-|\\*|\\/|\\%|\\=|\\=\\=|\\!\\=|\\<|\\>|\\<\\=|\\>\\=|\\&|\\||\\^|\\~|\\=\\>|\\-\\>|\\!)"
        }
      ]
    }
  },
  "scopeName": "source.end"
}
