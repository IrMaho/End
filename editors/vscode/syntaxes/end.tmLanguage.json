{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "End",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#decorators"
    },
    {
      "include": "#types"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.end",
          "match": "//.*$"
        },
        {
          "name": "comment.block.end",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.tag.decorator.end",
          "match": "@(target|optimize|align|intrinsic|pure|effect)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.end",
          "match": "\\b(if|else|while|for|in|ret|break|continue|match|parallel)\\b"
        },
        {
          "name": "keyword.other.memory.end",
          "match": "\\b(region|mut|val|pure|effect)\\b"
        },
        {
          "name": "keyword.declaration.end",
          "match": "\\b(fn|st|enum|asm|import|from)\\b"
        },
        {
          "name": "constant.language.boolean.end",
          "match": "\\b(true|false|null|void)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.end",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|str|void|SimdVec|Agent)\\b"
        },
        {
          "name": "entity.name.type.struct.end",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.end",
          "match": "\\b(println|print|inspect|trace|effects|impact|assert|alloc|free)\\b"
        },
        {
          "name": "entity.name.function.end",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.end",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.end",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.end",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.end",
          "match": "\\b0b[01_]+\\b"
        },
        {
          "name": "constant.numeric.float.end",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.decimal.end",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.end",
          "match": "(\\+|\\-|\\*|\\/|\\%|\\=|\\=\\=|\\!\\=|\\<|\\>|\\<\\=|\\>\\=|\\&|\\||\\^|\\~|\\=\\>|\\-\\>)"
        }
      ]
    }
  },
  "scopeName": "source.end"
}
