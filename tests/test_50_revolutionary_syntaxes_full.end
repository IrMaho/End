fn run_domain_5_math_financial_tests(h: TestHarness) TestHarness {
    println("  [Running Domain 5: Financial Precision & Units (25 Tests)]...");
    val mut_h = h;
    // Feature 21: 128-Bit Zero-Drift Decimals (5 Tests)
    mut_h = assert_eq_i64(mut_h, exact_decimal_sum(1035500, 50000), 1085500, "T101: Decimal Sum 1");
    mut_h = assert_eq_i64(mut_h, exact_decimal_sum(500000, 250000), 750000, "T102: Decimal Sum 2");
    mut_h = assert_eq_i64(mut_h, exact_decimal_sum(100, 99), 199, "T103: Decimal Sum 3");
    mut_h = assert_eq_i64(mut_h, exact_decimal_sum(5920000, 800000), 6720000, "T104: Decimal Sum 4");
    mut_h = assert_eq_i64(mut_h, exact_decimal_sum(0, 500), 500, "T105: Decimal Sum 5");
    // Feature 22: Physical Dimension Units (5 Tests)
    mut_h = assert_eq_i64(mut_h, physics_convert_speed(10), 36, "T106: 10 m/s -> 36 km/h");
    mut_h = assert_eq_i64(mut_h, physics_convert_speed(20), 72, "T107: 20 m/s -> 72 km/h");
    mut_h = assert_eq_i64(mut_h, physics_convert_speed(30), 108, "T108: 30 m/s -> 108 km/h");
    mut_h = assert_eq_i64(mut_h, physics_convert_speed(50), 180, "T109: 50 m/s -> 180 km/h");
    mut_h = assert_eq_i64(mut_h, physics_convert_speed(0), 0, "T110: 0 m/s -> 0 km/h");
    // Feature 23: Double-Entry Ledger Balancer (5 Tests)
    mut_h = assert_true(mut_h, ledger_balance_check(5000, 5000), "T111: Ledger Balance 5k");
    mut_h = assert_true(mut_h, ledger_balance_check(10000, 10000), "T112: Ledger Balance 10k");
    mut_h = assert_true(mut_h, ledger_balance_check(25000, 25000), "T113: Ledger Balance 25k");
    mut_h = assert_true(mut_h, ledger_balance_check(59200, 59200), "T114: Ledger Balance 59.2k");
    mut_h = assert_true(mut_h, ledger_balance_check(0, 0), "T115: Ledger Balance 0");
    // Feature 24: Matrix Tensor Operations (5 Tests)
    mut_h = assert_eq_i64(mut_h, matrix_dot_2x2(1, 2, 3, 4), 11, "T116: Matrix Dot 1");
    mut_h = assert_eq_i64(mut_h, matrix_dot_2x2(2, 3, 4, 5), 23, "T117: Matrix Dot 2");
    mut_h = assert_eq_i64(mut_h, matrix_dot_2x2(5, 5, 2, 2), 20, "T118: Matrix Dot 3");
    mut_h = assert_eq_i64(mut_h, matrix_dot_2x2(10, 0, 5, 5), 50, "T119: Matrix Dot 4");
    mut_h = assert_eq_i64(mut_h, matrix_dot_2x2(0, 0, 0, 0), 0, "T120: Matrix Dot 0");
    // Feature 25: Zero-Copy Array Slicing (5 Tests)
    mut_h = assert_eq_i64(mut_h, slice_window_sum(0, 10), 10, "T121: Window 0..10");
    mut_h = assert_eq_i64(mut_h, slice_window_sum(10, 20), 30, "T122: Window 10..30");
    mut_h = assert_eq_i64(mut_h, slice_window_sum(50, 50), 100, "T123: Window 50..100");
    mut_h = assert_eq_i64(mut_h, slice_window_sum(100, 100), 200, "T124: Window 100..200");
    mut_h = assert_eq_i64(mut_h, slice_window_sum(0, 0), 0, "T125: Window 0");
    return mut_h;
}

fn run_domain_6_concurrency_tests(h: TestHarness) TestHarness {
    println("  [Running Domain 6: Concurrency & Fiber Atomics (25 Tests)]...");
    val mut_h = h;
