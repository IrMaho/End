fn run_domain_10_ffi_simd_tests(h: TestHarness) TestHarness {
    println("  [Running Domain 10: Seamless FFI & SIMD Vectors (25 Tests)]...");
    val mut_h = h;
    // Feature 46: Direct Inlined C Headers (5 Tests)
    mut_h = assert_eq_i64(mut_h, c_inline_sqrt(100), 10, "T226: Inline Sqrt 100");
