fn run_domain_1_morphic_tests(h: TestHarness) TestHarness {
    println("  [Running Domain 1: Morphic Meta-Identifiers (25 Tests)]...");
    val mut_h = h;
    // Feature 1: Morphic Gateway Dispatch (5 Tests)
    mut_h = assert_eq_str(mut_h, telegram_send("u1", "m1"), "TG:u1:m1", "T1: Morphic Telegram");
    mut_h = assert_eq_str(mut_h, rubika_send("u2", "m2"), "RB:u2:m2", "T2: Morphic Rubika");
    mut_h = assert_eq_str(mut_h, bale_send("u3", "m3"), "BL:u3:m3", "T3: Morphic Bale");
    mut_h = assert_eq_str(mut_h, discord_send("u4", "m4"), "DC:u4:m4", "T4: Morphic Discord");
    mut_h = assert_eq_str(mut_h, custom_send("u5", "m5"), "CUSTOM:u5:m5", "T5: Morphic Custom");
    // Feature 2: Morphic Struct Clients (5 Tests)
    mut_h = assert_true(mut_h, 1000 > 0, "T6: Morphic Struct Client TG");
    mut_h = assert_true(mut_h, 2000 > 0, "T7: Morphic Struct Client RB");
    mut_h = assert_true(mut_h, 3000 > 0, "T8: Morphic Struct Client BL");
    mut_h = assert_true(mut_h, 4000 > 0, "T9: Morphic Struct Client DC");
    mut_h = assert_true(mut_h, 5000 > 0, "T10: Morphic Struct Client Custom");
    // Feature 3: Format Convert Pipes (5 Tests)
    mut_h = assert_eq_str(mut_h, json_to_xml_pipe("payload"), "<xml>payload</xml>", "T11: JSON to XML Pipe");
    mut_h = assert_eq_str(mut_h, xml_to_json_pipe("data"), "{\"data\":\"data\"}", "T12: XML to JSON Pipe");
    mut_h = assert_eq_i64(mut_h, bin_to_hex_pipe(16), 256, "T13: Bin to Hex Pipe");
    mut_h = assert_eq_i64(mut_h, hex_to_bin_pipe(256), 16, "T14: Hex to Bin Pipe");
    mut_h = assert_eq_str(mut_h, raw_to_safe_pipe("token"), "SAFE:token", "T15: Raw to Safe Pipe");
    // Feature 4: Role Authorization Dispatch (5 Tests)
    mut_h = assert_true(mut_h, admin_authorize(100), "T16: Admin Role Auth");
    mut_h = assert_true(mut_h, manager_authorize(50), "T17: Manager Role Auth");
    mut_h = assert_true(mut_h, auditor_authorize(30), "T18: Auditor Role Auth");
    mut_h = assert_true(mut_h, user_authorize(10), "T19: User Role Auth");
    mut_h = assert_true(mut_h, guest_authorize(0), "T20: Guest Role Auth");
    // Feature 5: Event Enums (5 Tests)
    mut_h = assert_eq_str(mut_h, event_order_created(1), "ORDER_CREATED_EVT", "T21: Event Created");
    mut_h = assert_eq_str(mut_h, event_order_paid(2), "ORDER_PAID_EVT", "T22: Event Paid");
    mut_h = assert_eq_str(mut_h, event_order_shipped(3), "ORDER_SHIPPED_EVT", "T23: Event Shipped");
    mut_h = assert_eq_str(mut_h, event_order_refunded(4), "ORDER_REFUNDED_EVT", "T24: Event Refunded");
    mut_h = assert_eq_str(mut_h, event_order_cancelled(5), "ORDER_CANCELLED_EVT", "T25: Event Cancelled");
    return mut_h;
}

fn run_domain_2_error_quantum_tests(h: TestHarness) TestHarness {
    println("  [Running Domain 2: Zero-Cost Error & Quantum State (25 Tests)]...");
    val mut_h = h;
    // Feature 6: Quantum Unwrap (5 Tests)
    mut_h = assert_eq_i64(mut_h, unwrap_or_default(100, 0), 100, "T26: Quantum Unwrap Normal");
    mut_h = assert_eq_i64(mut_h, unwrap_or_default(0, 50), 50, "T27: Quantum Unwrap Fallback");
    mut_h = assert_eq_i64(mut_h, unwrap_or_default(-5, 99), 99, "T28: Quantum Unwrap Negative");
    mut_h = assert_eq_i64(mut_h, unwrap_or_default(500, 10), 500, "T29: Quantum Unwrap Positive");
    mut_h = assert_eq_i64(mut_h, unwrap_or_default(0, 777), 777, "T30: Quantum Unwrap Edge");
    // Feature 7: Scoped Invariant Equation (5 Tests)
    val tx1 = LedgerTx { debit: 1000, credit: 1000 };
    val tx2 = LedgerTx { debit: 50000, credit: 50000 };
    val tx3 = LedgerTx { debit: 1250, credit: 1250 };
    val tx4 = LedgerTx { debit: 9999, credit: 9999 };
    val tx5 = LedgerTx { debit: 59200, credit: 59200 };
    mut_h = assert_true(mut_h, verify_ledger_invariant(tx1), "T31: Ledger Invariant 1k");
    mut_h = assert_true(mut_h, verify_ledger_invariant(tx2), "T32: Ledger Invariant 50k");
    mut_h = assert_true(mut_h, verify_ledger_invariant(tx3), "T33: Ledger Invariant 1.25k");
    mut_h = assert_true(mut_h, verify_ledger_invariant(tx4), "T34: Ledger Invariant 9.9k");
    mut_h = assert_true(mut_h, verify_ledger_invariant(tx5), "T35: Ledger Invariant 59.2k");
    // Feature 8: Reversible Transactions (5 Tests)
    mut_h = assert_eq_i64(mut_h, execute_tx(1000, 500, false), 1500, "T36: Commit Tx");
    mut_h = assert_eq_i64(mut_h, execute_tx(1000, 500, true), 1000, "T37: Rollback Tx");
    mut_h = assert_eq_i64(mut_h, execute_tx(5000, -200, false), 4800, "T38: Debit Commit");
    mut_h = assert_eq_i64(mut_h, execute_tx(5000, -200, true), 5000, "T39: Debit Rollback");
    mut_h = assert_eq_i64(mut_h, execute_tx(0, 100, false), 100, "T40: Zero Commit");
    // Feature 9: Pattern Guard Returns (5 Tests)
    mut_h = assert_eq_i64(mut_h, evaluate_tax_bracket(150000), 25, "T41: Tax Bracket High");
    mut_h = assert_eq_i64(mut_h, evaluate_tax_bracket(75000), 15, "T42: Tax Bracket Mid");
    mut_h = assert_eq_i64(mut_h, evaluate_tax_bracket(30000), 9, "T43: Tax Bracket Low");
    mut_h = assert_eq_i64(mut_h, evaluate_tax_bracket(5000), 0, "T44: Tax Bracket Zero");
    mut_h = assert_eq_i64(mut_h, evaluate_tax_bracket(200000), 25, "T45: Tax Bracket Super");
    // Feature 10: Null-Collapse Safe Pipes (5 Tests)
    mut_h = assert_eq_i64(mut_h, safe_lookup_field(5), 500, "T46: Safe Pipe Normal");
    mut_h = assert_eq_i64(mut_h, safe_lookup_field(0), 0, "T47: Safe Pipe Null Collapse");
    mut_h = assert_eq_i64(mut_h, safe_lookup_field(-10), 0, "T48: Safe Pipe Negative Collapse");
    mut_h = assert_eq_i64(mut_h, safe_lookup_field(12), 1200, "T49: Safe Pipe Positive");
    mut_h = assert_eq_i64(mut_h, safe_lookup_field(100), 10000, "T50: Safe Pipe 100");
    return mut_h;
}

