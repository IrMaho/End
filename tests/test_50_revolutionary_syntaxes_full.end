@intent("Morphic Dispatch: Discord Gateway")
fn discord_send(to: str, msg: str) str { return "DC:" + to + ":" + msg; }

@intent("Morphic Dispatch: Custom Webhook Gateway")
fn custom_send(to: str, msg: str) str { return "CUSTOM:" + to + ":" + msg; }

