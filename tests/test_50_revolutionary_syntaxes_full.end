st TestHarness {
    total_passed: i64,
    total_failed: i64,
}

fn assert_true(harness: TestHarness, condition: bool, test_name: str) TestHarness {
    if condition {
        val next_passed = harness.total_passed + 1;
        return TestHarness { total_passed: next_passed, total_failed: harness.total_failed };
    }
    println("❌ FAILED ASSERTION");
    val next_failed = harness.total_failed + 1;
    return TestHarness { total_passed: harness.total_passed, total_failed: next_failed };
}

fn assert_eq_i64(harness: TestHarness, actual_val: i64, expected_val: i64, test_name: str) TestHarness {
    if actual_val == expected_val {
        val next_passed = harness.total_passed + 1;
        return TestHarness { total_passed: next_passed, total_failed: harness.total_failed };
    }
    println("❌ FAILED I64 ASSERTION");
    val next_failed = harness.total_failed + 1;
    return TestHarness { total_passed: harness.total_passed, total_failed: next_failed };
}

fn assert_eq_str(harness: TestHarness, actual_str: str, expected_str: str, test_name: str) TestHarness {
    if actual_str == expected_str {
        val next_passed = harness.total_passed + 1;
        return TestHarness { total_passed: next_passed, total_failed: harness.total_failed };
    }
    println("❌ FAILED STR ASSERTION");
    val next_failed = harness.total_failed + 1;
    return TestHarness { total_passed: harness.total_passed, total_failed: next_failed };
}

