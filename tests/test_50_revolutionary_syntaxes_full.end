fn run_domain_8_security_zero_trust_tests(h: TestHarness) TestHarness {
    println("  [Running Domain 8: Zero-Trust Security & Tainting (25 Tests)]...");
    val mut_h = h;
    // Feature 36: Tainted / Sanitized Data (5 Tests)
    mut_h = assert_eq_str(mut_h, sanitize_user_input("normal_user"), "normal_user", "T176: Sanitize Normal");
    mut_h = assert_eq_str(mut_h, sanitize_user_input("admin' OR 1=1--"), "admin_escaped", "T177: Sanitize Attack");
    mut_h = assert_eq_str(mut_h, sanitize_user_input("john_doe"), "john_doe", "T178: Sanitize John");
    mut_h = assert_eq_str(mut_h, sanitize_user_input("root"), "root", "T179: Sanitize Root");
    mut_h = assert_eq_str(mut_h, sanitize_user_input("moderator"), "moderator", "T180: Sanitize Mod");
    // Feature 37: Memory Quarantine (5 Tests)
    mut_h = assert_true(mut_h, quarantine_execute(100), "T181: Quarantine 100");
    mut_h = assert_true(mut_h, quarantine_execute(200), "T182: Quarantine 200");
    mut_h = assert_true(mut_h, quarantine_execute(500), "T183: Quarantine 500");
    mut_h = assert_true(mut_h, quarantine_execute(1000), "T184: Quarantine 1000");
    mut_h = assert_true(mut_h, quarantine_execute(5000), "T185: Quarantine 5000");
    // Feature 38: Auto-Redacted Secrets (5 Tests)
    mut_h = assert_eq_str(mut_h, format_log_user("ali", "hash123"), "User: ali [REDACTED]", "T186: Secret Mask 1");
    mut_h = assert_eq_str(mut_h, format_log_user("reza", "hash456"), "User: reza [REDACTED]", "T187: Secret Mask 2");
    mut_h = assert_eq_str(mut_h, format_log_user("sara", "hash789"), "User: sara [REDACTED]", "T188: Secret Mask 3");
    mut_h = assert_eq_str(mut_h, format_log_user("admin", "hash000"), "User: admin [REDACTED]", "T189: Secret Mask 4");
    mut_h = assert_eq_str(mut_h, format_log_user("guest", "hash999"), "User: guest [REDACTED]", "T190: Secret Mask 5");
    // Feature 39: Capability Security (5 Tests)
    mut_h = assert_true(mut_h, check_admin_capability(true), "T191: Capability Grant");
    mut_h = assert_true(mut_h, !check_admin_capability(false), "T192: Capability Revoke");
    mut_h = assert_true(mut_h, check_admin_capability(true), "T193: Capability Audit");
    mut_h = assert_true(mut_h, check_admin_capability(true), "T194: Capability Post");
    mut_h = assert_true(mut_h, !check_admin_capability(false), "T195: Capability Guest Deny");
    // Feature 40: Hardware AES-NI Encryption (5 Tests)
    mut_h = assert_eq_i64(mut_h, encrypt_memory_buffer(64), 80, "T196: AES Buffer 64B");
    mut_h = assert_eq_i64(mut_h, encrypt_memory_buffer(128), 144, "T197: AES Buffer 128B");
    mut_h = assert_eq_i64(mut_h, encrypt_memory_buffer(256), 272, "T198: AES Buffer 256B");
    mut_h = assert_eq_i64(mut_h, encrypt_memory_buffer(512), 528, "T199: AES Buffer 512B");
    mut_h = assert_eq_i64(mut_h, encrypt_memory_buffer(1024), 1040, "T200: AES Buffer 1KB");
    return mut_h;
}

fn run_domain_9_comptime_tests(h: TestHarness) TestHarness {
    println("  [Running Domain 9: Compile-Time Metaprogramming (25 Tests)]...");
    val mut_h = h;
