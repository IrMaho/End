    mut_h = assert_eq_i64(mut_h, spawn_fiber_task(50), 500, "T130: Fiber Span 50");
    // Feature 27: Channel Select (5 Tests)
    mut_h = assert_eq_i64(mut_h, channel_select_ready(true, false), 1, "T131: Channel A Ready");
    mut_h = assert_eq_i64(mut_h, channel_select_ready(false, true), 2, "T132: Channel B Ready");
    mut_h = assert_eq_i64(mut_h, channel_select_ready(true, true), 1, "T133: Channel Both Ready");
    mut_h = assert_eq_i64(mut_h, channel_select_ready(false, false), 0, "T134: Channel None Ready");
    mut_h = assert_eq_i64(mut_h, channel_select_ready(true, false), 1, "T135: Channel A Repeat");
    // Feature 28: Actor Mailboxes (5 Tests)
    mut_h = assert_true(mut_h, actor_enqueue_message(10, 50000), "T136: Actor Mailbox 10/50k");
    mut_h = assert_true(mut_h, actor_enqueue_message(1000, 50000), "T137: Actor Mailbox 1k/50k");
    mut_h = assert_true(mut_h, actor_enqueue_message(25000, 50000), "T138: Actor Mailbox 25k/50k");
    mut_h = assert_true(mut_h, actor_enqueue_message(49999, 50000), "T139: Actor Mailbox 49.9k/50k");
    mut_h = assert_true(mut_h, actor_enqueue_message(0, 50000), "T140: Actor Mailbox 0/50k");
    // Feature 29: Hardware Atomics (5 Tests)
    mut_h = assert_eq_i64(mut_h, atomic_fetch_add(100, 1), 101, "T141: Atomic Add 1");
    mut_h = assert_eq_i64(mut_h, atomic_fetch_add(500, 50), 550, "T142: Atomic Add 50");
