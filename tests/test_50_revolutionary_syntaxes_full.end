    mut_h = assert_eq_i64(mut_h, atomic_fetch_add(0, 5), 5, "T145: Atomic Add 5");
    // Feature 30: Async Comprehensions (5 Tests)
    mut_h = assert_eq_i64(mut_h, parallel_map_item(1), 100, "T146: Async Map 1");
    mut_h = assert_eq_i64(mut_h, parallel_map_item(2), 200, "T147: Async Map 2");
