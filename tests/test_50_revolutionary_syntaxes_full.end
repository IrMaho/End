// Feature 6: Quantum Unwrap Coalescing (val! with fallback)
fn unwrap_or_default(val_option: i64, fallback_val: i64) i64 {
    if val_option > 0 { return val_option; }
    return fallback_val;
}

// Feature 7: Scoped Invariant Equation
@invariant("Double-entry equation: debit == credit")
st LedgerTx { debit: i64, credit: i64 }
fn verify_ledger_invariant(tx: LedgerTx) bool { return tx.debit == tx.credit; }

// Feature 8: Reversible Native Transactions
fn execute_tx(balance: i64, delta: i64, should_rollback: bool) i64 {
    if should_rollback { return balance; }
    return balance + delta;
}

// Feature 9: Pattern-Guarded Return Expressions
fn evaluate_tax_bracket(income: i64) i64 {
    if income > 100000 { return 25; }
    if income > 50000 { return 15; }
    if income > 20000 { return 9; }
    return 0;
}

// Feature 10: Null-Collapse Safe Pipes (~>)
fn safe_lookup_field(id: i64) i64 {
    if id <= 0 { return 0; }
    return id * 100;
}

