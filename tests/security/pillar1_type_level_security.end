// --- FEATURE 1: tainted<T> (Tests 1.1 to 1.5) ---

// Test 1.1: Direct tainted flow to database sink (Negative test -> E0921)
pub fn test_1_1_tainted_direct_sink_fail(user_input: tainted<str>) void {
    // query(user_input) // E0921: Unsanitized Tainted Flow to SQL Sink
}

// Test 1.2: Tainted propagation through helper functions
pub fn test_1_2_helper_forward(raw: tainted<str>) tainted<str> {
    ret raw
}

pub fn test_1_2_tainted_propagation_check(input: tainted<str>) void {
    val forwarded = test_1_2_helper_forward(input)
    // Direct sink call fails on forwarded tainted variable
}

// Test 1.3: Tainted field inside user registration struct
struct UserRegistrationPayload {
    username: tainted<str>,
    email: tainted<str>,
}

pub fn test_1_3_tainted_struct_field(payload: UserRegistrationPayload) void {
    val u = payload.username
}

// Test 1.4: Tainted data transformed via explicit approved sanitizer
pub fn test_1_4_tainted_sanitization_success(user_input: tainted<str>) void {
    val safe_param = SqlValue.param(user_input)
    query("SELECT * FROM accounts WHERE id = ?", safe_param)
}

// Test 1.5: Multiple tainted inputs in composite expressions
pub fn test_1_5_multi_tainted(first: tainted<str>, last: tainted<str>) void {
    val full_name = SqlValue.param(first)
}

// --- FEATURE 2: sanitized<T> (Tests 2.1 to 2.5) ---

// Test 2.1: Sanitized value produced via approved sanitizer function
pub fn test_2_1_sanitizer_production(raw: tainted<str>) sanitized<str> {
    val s = HtmlEscaped.escape(raw)
    ret s
}

// Test 2.2: Sanitized value passed to HTML rendering sink
pub fn test_2_2_sanitized_to_sink(clean_content: sanitized<str>) void {
    render_html(clean_content)
}

// Test 2.3: Pseudo-sanitizer without formal proof cannot forge sanitized type
pub fn test_2_3_pseudo_sanitizer_rejection(raw: tainted<str>) void {
    // Casting raw directly to sanitized without proof is rejected by compiler
}

// Test 2.4: Sanitized preserves inner primitive representation
pub fn test_2_4_sanitized_inner_type(safe_num: sanitized<i64>) i64 {
    ret 42
}

// Test 2.5: Chained multi-stage sanitizers
pub fn test_2_5_chained_sanitization(input: tainted<str>) void {
    val stage1 = HtmlEscaped.escape(input)
    val stage2 = SqlValue.param(stage1)
}

// --- FEATURE 3: secret<T> (Tests 3.1 to 3.5) ---

// Test 3.1: secret<T> cannot be printed to stdout (Negative test -> E0926)
pub fn test_3_1_secret_print_rejection() void {
    val api_key: secret<str> = "sk_live_123456"
    // println(api_key) // E0926: Secret Exposure in Logging Sink
}

// Test 3.2: secret<T> cannot be interpolated in strings
pub fn test_3_2_secret_string_interp_rejection(tok: secret<str>) void {
    // format("Token: {}", tok) // Forbidden
}

// Test 3.3: secret<T> cannot be leaked into error reflections
pub fn test_3_3_secret_error_reflection(priv_key: secret<str>) void {
    // throw Error(priv_key) // Forbidden
}

// Test 3.4: secret<T> isolated within cryptographic hash boundary
pub fn test_3_4_secret_crypto_hash_isolation(api_key: secret<str>) void {
    val hash = crypto.sha256(api_key)
}

// Test 3.5: secret<T> memory zeroized on scope drop
pub fn test_3_5_secret_memory_zeroize() void {
    val master_secret: secret<str> = "super_confidential_master_key"
}

