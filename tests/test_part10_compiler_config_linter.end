// 👑 End Language: tests/test_part10_compiler_config_linter.end
// Comprehensive Test Suite for Compiler Architecture Config & Linter Enforcement

pub struct LintReport {
    pub total_files_scanned: i32,
    pub errors_found: i32,
    pub warnings_found: i32,
    pub is_clean: bool,
}

pub fn create_lint_report(scanned: i32, errors: i32, warnings: i32) LintReport {
    ret LintReport {
        total_files_scanned: scanned,
        errors_found: errors,
        warnings_found: warnings,
        is_clean: errors == 0,
    }
}

pub fn validate_file_line_budget(lines: i32, max_allowed: i32) bool {
    if lines <= max_allowed {
        ret true
    }
    ret false
}

pub fn main() void {
    println("👑 ========================================================")
    println("👑 STARTING COMPILER CONFIG & LINTER TEST SUITE")
    println("👑 ========================================================")

    // ────────────────────────────────────────────
    // 1. File Size Guardrail Validation
    // ────────────────────────────────────────────
    println("--- 1. Testing File Size Guardrails ---")
    val is_under_limit = validate_file_line_budget(45, 200)
    println("File with 45 lines <= 200 limit (Must be true):")
    println(is_under_limit)

    val is_over_limit = validate_file_line_budget(312, 200)
    println("File with 312 lines <= 200 limit (Must be false):")
    println(is_over_limit)
    println("✔ File Line Limits Enforced!")

    // ────────────────────────────────────────────
    // 2. Linter Report Generation
    // ────────────────────────────────────────────
    println("--- 2. Testing Linter Report Verification ---")
    val clean_report = create_lint_report(12, 0, 0)
    println("Clean Project Scanned Files (Must be 12):")
    println(clean_report.total_files_scanned)
    println("Clean Project Errors (Must be 0):")
    println(clean_report.errors_found)
    println("Is Clean (Must be true):")
    println(clean_report.is_clean)

    val dirty_report = create_lint_report(5, 3, 1)
    println("Dirty Project Errors (Must be 3):")
    println(dirty_report.errors_found)
    println("Is Clean (Must be false):")
    println(dirty_report.is_clean)
    println("✔ Linter Reporting Model Verified!")

    println("👑 ALL COMPILER CONFIG & LINTER TESTS PASSED! 👑")
}
