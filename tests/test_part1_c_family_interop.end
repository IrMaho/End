pub extern fn abs(n: i32) i32
pub extern fn strlen(s: str) u64

pub fn main() void {
    println("👑 ========================================================")
    println("👑 STARTING PART 1: UNIVERSAL C-FAMILY INTEROP TEST SUITE")
    println("👑 ========================================================")

    // 1. Testing C-Header Generated Constants & Types
