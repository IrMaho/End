enum TargetPlatform {
    Telegram,
    Rubika,
    Bale,
    Discord
}

st MorphicDispatcher {
    platform_name: str,
    prefix: str
}

fn telegram_dispatch(chat_id: str, message: str) str {
    val prefix = "✈️ [Telegram]";
    return prefix + " -> Sent to " + chat_id + ": " + message;
}

fn rubika_dispatch(chat_id: str, message: str) str {
    val prefix = "🟣 [Rubika]";
    return prefix + " -> Sent to " + chat_id + ": " + message;
}

fn bale_dispatch(chat_id: str, message: str) str {
    val prefix = "🟢 [Bale]";
    return prefix + " -> Sent to " + chat_id + ": " + message;
}

fn discord_dispatch(chat_id: str, message: str) str {
    val prefix = "🎮 [Discord]";
    return prefix + " -> Sent to " + chat_id + ": " + message;
}

st FinancialTransaction {
    debit_cents: i64,
    credit_cents: i64
}

fn is_transaction_balanced(tx: FinancialTransaction) bool {
    // Invariant rule: Debits == Credits
    return tx.debit_cents == tx.credit_cents;
}

fn bool_to_str(b: bool) str {
    if b {
        return "true (Invariant 100% Balanced)";
    }
    return "false (Drift Detected)";
}

fn compute_vat(subtotal_cents: i64, tax_rate_percent: i64) i64 {
    return (subtotal_cents * tax_rate_percent) / 100;
}

