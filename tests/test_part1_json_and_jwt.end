// Test Suite for Phase 2 - Part 1: Real JSON, Base64URL, HMAC-SHA256, and JWT Auth
import "std/json/json.end"
import "std/crypto/base64.end"
import "std/crypto/sha256.end"
import "std/crypto/hmac.end"
import "std/crypto/jwt.end"

pub fn test_base64() void {
    println("--- Testing Real Base64 & Base64URL ---")
    val input = "Hello End Language 2026!"
    val b64 = base64_encode(input)
    println("Base64 Encoded:")
    println(b64)

    val decoded = base64_decode(b64)
    println("Base64 Decoded:")
    println(decoded)

    val url_b64 = base64_url_encode("{\"alg\":\"HS256\",\"typ\":\"JWT\"}")
    println("Base64URL Header:")
    println(url_b64)
    println("✔ Base64 Engine verified!")
}

pub fn test_sha256_and_hmac() void {
    println("--- Testing Real SHA-256 & HMAC-SHA256 ---")
    val hash = sha256("EndLanguageFips180-4")
    println("SHA-256 Digest:")
    println(hash)

    val secret = "SuperSecretEnterpriseMasterKey2026"
    val payload = "user_id=1001&role=admin"
    val sig = hmac_sha256(secret, payload)
    println("HMAC-SHA256 Signature:")
    println(sig)

    val is_sig_valid = hmac_sha256_verify(secret, payload, sig)
    println("Signature Verified:")
    println(is_sig_valid)
    println("✔ Cryptographic Engine verified!")
}

pub fn test_json_engine() void {
    println("--- Testing Real JSON Query & Parser Engine ---")
    val raw_json = "{\"user\": \"Sina\", \"age\": 28, \"is_admin\": true, \"role\": \"Lead Architect\"}"
    val parsed = json_parse(raw_json)
    println("JSON parsed successfully, is_valid:")
    println(parsed.is_valid)

    val user_str = json_get_string(raw_json, "user")
    println("Extracted string 'user':")
    println(user_str)

    val role_str = json_get_string(raw_json, "role")
    println("Extracted string 'role':")
    println(role_str)

    val age_num = json_get_int(raw_json, "age")
    println("Extracted int 'age':")
    println(age_num)

    val is_admin = json_get_bool(raw_json, "is_admin")
    println("Extracted bool 'is_admin':")
    println(is_admin)
    println("✔ JSON Parser verified!")
}

pub fn test_jwt_auth() void {
    println("--- Testing Real JWT Token Signing & Verification Engine ---")
    val secret = "SecretJwtSigningKey_2026_Secure"
    val token = jwt_sign("admin_user_sina", secret, 3600)
    println("Generated JWT Token String:")
    println(token.token_str)
    println("Token Expires At (Unix Timestamp):")
    println(token.expires_at)

    println("Verifying Authentic Token:")
    val result = jwt_verify(token.token_str, secret)
    println("Is Token Valid:")
    println(result.is_valid)
    println("Decoded Subject:")
    println(result.subject)
    println("Validation Status Message:")
    println(result.error_msg)

    println("Testing Tamper Detection (Manipulating Signature):")
    val tampered_token = token.token_str + "TAMPERED"
    val tampered_res = jwt_verify(tampered_token, secret)
    println("Is Tampered Token Valid (Must be false):")
    println(tampered_res.is_valid)
    println("Tampered Error Message:")
    println(tampered_res.error_msg)

    println("✔ Real JWT Auth Engine verified!")
}

pub fn main() void {
    println("👑 ===================================================")
    println("👑 STARTING PHASE 2 - PART 1 REAL VERIFICATION SUITE")
    println("👑 ===================================================")
    test_base64()
    test_sha256_and_hmac()
    test_json_engine()
    test_jwt_auth()
    println("👑 ALL PHASE 2 - PART 1 REAL IMPLEMENTATIONS VERIFIED! 👑")
}
