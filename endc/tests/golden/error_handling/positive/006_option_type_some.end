// @test: positive
// @expect-stdout:
// 4

st Option {
    has_value: bool,
    value: i64,
}

fn find_even(x: i64) Option {
    if x % 2 == 0 {
        ret Option { has_value: true, value: x }
    }
    ret Option { has_value: false, value: 0 }
}

fn main() void {
    val opt = find_even(4)
    if opt.has_value {
        println(opt.value)
    }
}
